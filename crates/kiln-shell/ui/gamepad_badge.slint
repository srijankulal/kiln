import { Theme } from "theme.slint";

export component GamepadBadge inherits Rectangle {
    in property <string> btn: "A";
    in property <color> btn_color: Theme.btn-a;
    in property <bool> is_pill: false;
    in property <string> label: "";

    HorizontalLayout {
        spacing: 8px;
        alignment: center;

        // Button Circle or Pill
        Rectangle {
            width: root.is_pill ? 38px : 24px;
            height: 24px;
            border-radius: root.is_pill ? 6px : 12px;
            background: root.btn_color;
            clip: true;

            // Subtle top highlight for 3D console look
            Rectangle {
                width: 100%;
                height: 50%;
                y: 0px;
                background: #FFFFFF30;
            }

            Text {
                text: root.btn;
                color: #FFFFFF;
                font-size: root.is_pill ? 11px : 13px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Accompanying Label
        if (root.label != ""): Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
