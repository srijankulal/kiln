// Design tokens for Kiln 10-foot TV UI.
// Built according to rust-ui-ux skill specifications and WCAG 2.x AA contrast rules.
export global Theme {
    in-out property <bool> dark: true;

    // Atmospheric Surfaces (Obsidian Basalt)
    out property <color> bg: dark ? #07090E : #f4f7fc;
    out property <color> surface: dark ? #111722 : #ffffff;
    out property <color> surface-raised: dark ? #192234 : #ecf1f7;
    out property <color> surface-card: dark ? #131B2B : #ffffff;
    out property <color> surface-card-focused: dark ? #1D2A44 : #f0f6ff;
    out property <color> surface-glass: dark ? #0A101DF0 : #fffffff2;

    // Structural Borders
    out property <color> border: dark ? #233047 : #dce2e9;
    out property <color> border-strong: dark ? #36486B : #888d94;
    out property <color> border-focus: dark ? #00D2FF : #007799;

    // Typographic Hierarchy (WCAG AA compliant contrast)
    out property <color> text: dark ? #F0F4F8 : #171b20;
    out property <color> text-muted: dark ? #8A98AC : #5f646a;
    out property <color> text-disabled: dark ? #4A5668 : #9a9fa6;

    // Primary Accents (Electric Cyan)
    out property <color> accent: dark ? #00D2FF : #0088AA;
    out property <color> accent-hover: dark ? #26DCFF : #007799;
    out property <color> on-accent: dark ? #07090E : #ffffff;
    out property <color> accent-fg: dark ? #00D2FF : #007799;
    out property <color> accent-subtle: dark ? #0B2535 : #e6faff;
    out property <color> focus: dark ? #00D2FF : #0088AA;

    // Semantic Status Colors
    out property <color> success: dark ? #47A05F : #1d7d3e;
    out property <color> success-subtle: dark ? #192925 : #ebf4ee;
    out property <color> warning: dark ? #F59E0B : #b45309;
    out property <color> warning-subtle: dark ? #2B2314 : #fef3c7;
    out property <color> danger: dark ? #EF4444 : #b91c1c;
    out property <color> danger-subtle: dark ? #2E1A1A : #fee2e2;

    // Kiln Console Brand & Launchers
    out property <color> accent-warm: #FF5533; // Ember flame
    out property <color> accent-gold: #FBBF24; // Star gold
    out property <color> steam-color: #1A78C2;
    out property <color> epic-color: #2D3748;
    out property <color> xbox-color: #107C10;
    out property <color> standalone-color: #8B5CF6;

    // Controller Buttons (Xbox physical colorway)
    out property <color> btn-a: #10B981; // Green
    out property <color> btn-b: #EF4444; // Red
    out property <color> btn-x: #3B82F6; // Blue
    out property <color> btn-y: #F59E0B; // Yellow
    out property <color> btn-bumper: #334155; // Slate

    // 10-Foot Safe Overscan Margins
    out property <length> safe-margin-h: 72px;
    out property <length> safe-margin-v: 40px;

    // Spacing Scale (2 / 4 / 8 / 12 / 16 / 24 / 32 / 48)
    out property <length> space-xxs: 2px;
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-xxl: 32px;
    out property <length> space-xxxl: 48px;

    // Radii Scale (Concentric)
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 10px;
    out property <length> radius-xl: 14px;
    out property <length> radius-full: 999px;

    // Font Scale
    out property <length> font-caption: 12px;
    out property <length> font-small: 14px;
    out property <length> font-body: 16px;
    out property <length> font-body-lg: 18px;
    out property <length> font-title: 22px;
    out property <length> font-headline: 28px;
    out property <length> font-display: 36px;

    // Elevation Shadows
    out property <length> e1-blur: 4px;
    out property <length> e1-offset: 2px;
    out property <color> e1-color: #00000040;

    out property <length> e2-blur: 16px;
    out property <length> e2-offset: 6px;
    out property <color> e2-color: #00000060;

    out property <length> e3-blur: 32px;
    out property <length> e3-offset: 12px;
    out property <color> e3-color: #00000080;

    // Motion Timing
    out property <duration> motion-fast: 120ms;
    out property <duration> motion-normal: 160ms;
    out property <duration> motion-slow: 240ms;

    // Convenience aliases
    out property <color> background: bg;
    out property <color> surface-variant: surface-raised;
    out property <color> border-subtle: border;
    out property <color> border-highlight: border-strong;
    out property <color> text-primary: text;
    out property <color> text-secondary: text-muted;
    out property <length> font-badge: font-caption;
    out property <length> font-hero: font-display;
    out property <color> accent-glow: accent-hover;
}
