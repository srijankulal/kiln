// Theme definitions for Kiln 10-foot TV UI

export global Theme {
    out property <color> background: #0A0D14;
    out property <color> surface: #141A28;
    out property <color> surface-variant: #1C2438;
    out property <color> surface-focused: #25314C;
    out property <color> surface-card: #161D2E;
    
    out property <color> accent: #00D2FF;
    out property <color> accent-glow: #00E5FF;
    out property <color> accent-warm: #FF6B4A;
    
    out property <color> text-primary: #FFFFFF;
    out property <color> text-secondary: #94A3B8;
    out property <color> text-muted: #64748B;
    
    out property <color> steam-color: #1A78C2;
    out property <color> epic-color: #313131;
    out property <color> xbox-color: #107C10;
    out property <color> standalone-color: #8B5CF6;

    out property <length> safe-margin-h: 80px;
    out property <length> safe-margin-v: 44px;

    out property <length> font-headline: 42px;
    out property <length> font-title: 32px;
    out property <length> font-body: 26px;
    out property <length> font-small: 20px;
}
