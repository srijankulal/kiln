import { Theme } from "theme.slint";

export component GameCard inherits Rectangle {
    in property <string> title: "Game Title";
    in property <string> launcher: "Steam";
    in property <bool> has_poster: false;
    in property <image> poster;
    in property <bool> is_favorite: false;
    in-out property <bool> is_card_focused: false;

    callback clicked();
    callback detail_requested();

    width: is_card_focused ? 212px : 192px;
    height: is_card_focused ? 318px : 288px;
    background: is_card_focused ? Theme.surface-card-focused : Theme.surface-card;
    border-radius: Theme.radius-lg;
    border-width: is_card_focused ? 2px : 1px;
    border-color: is_card_focused ? Theme.focus : Theme.border-subtle;
    drop-shadow-blur: is_card_focused ? 16px : 6px;
    drop-shadow-offset-y: is_card_focused ? 6px : 2px;
    drop-shadow-color: is_card_focused ? #00D2FF40 : #00000070;
    clip: true;

    accessible-role: button;
    accessible-label: root.title + ", " + root.launcher;

    animate width, height, border-color, background {
        duration: Theme.motion-normal;
        easing: ease-out;
    }

    // Main Card Layers
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        // Layer 1: Poster Artwork or Procedural Graphic
        if (root.has_poster): Image {
            width: 100%;
            height: 100%;
            source: root.poster;
            image-fit: cover;
        }

        if (!root.has_poster): Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(145deg, #1A1F36 0%, #0F1626 50%, #151D30 100%);

            VerticalLayout {
                alignment: center;
                padding: Theme.space-lg;
                spacing: Theme.space-md;

                // Stylized Game Controller Icon
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 26px;
                    background: #FFFFFF15;
                    border-width: 1px;
                    border-color: #FFFFFF25;

                    Text {
                        text: "🎮";
                        font-size: 24px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        // Layer 2: Favorite Star Badge (Top-Right)
        if (root.is_favorite): Rectangle {
            x: parent.width - 36px;
            y: Theme.space-md;
            width: 26px;
            height: 26px;
            border-radius: Theme.radius-full;
            background: #000000B8;
            border-width: 1px;
            border-color: Theme.accent-gold;

            Text {
                text: "★";
                color: Theme.accent-gold;
                font-size: 14px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Layer 3: Bottom Gradient Vignette & Metadata Overlay
        Rectangle {
            y: parent.height - 96px;
            height: 96px;
            width: 100%;
            background: @linear-gradient(0deg, #07090EF8 0%, #07090ECC 50%, #00000000 100%);

            VerticalLayout {
                padding-left: Theme.space-lg;
                padding-right: Theme.space-lg;
                padding-bottom: Theme.space-md;
                alignment: end;
                spacing: Theme.space-xs;

                // Title
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 800;
                    overflow: elide;
                }

                // Launcher Pill & Focus Status
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    alignment: space-between;

                    // Launcher Tag
                    Rectangle {
                        height: 20px;
                        border-radius: Theme.radius-sm;
                        background: root.launcher == "Steam" ? Theme.steam-color :
                                   (root.launcher == "Epic" ? Theme.epic-color :
                                   (root.launcher == "Xbox" ? Theme.xbox-color : Theme.standalone-color));

                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: root.launcher;
                                color: #FFFFFF;
                                font-size: Theme.font-caption;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if (root.is_card_focused): Text {
                        text: "READY";
                        color: Theme.accent-fg;
                        font-size: Theme.font-caption;
                        font-weight: 800;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Mouse & Touch click support
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.clicked();
            }
        }
    }
}
