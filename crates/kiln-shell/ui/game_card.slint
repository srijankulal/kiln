import { Theme } from "theme.slint";

export component GameCard inherits Rectangle {
    in property <string> title: "Game Title";
    in property <string> launcher: "Steam";
    in property <bool> has_poster: false;
    in property <image> poster;
    in property <bool> is_favorite: false;
    in-out property <bool> is_card_focused: false;

    callback clicked();
    callback detail_requested();

    width: is_card_focused ? 226px : 206px;
    height: is_card_focused ? 339px : 309px;
    background: is_card_focused ? Theme.surface-focused : Theme.surface-card;
    border-radius: 14px;
    border-width: is_card_focused ? 3px : 1px;
    border-color: is_card_focused ? Theme.accent-glow : Theme.border-subtle;
    clip: true;

    animate width, height, border-color, background {
        duration: 130ms;
        easing: ease-out;
    }

    // Main Card Layers
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        // Layer 1: Poster Artwork or Procedural Graphic
        if (root.has_poster): Image {
            width: 100%;
            height: 100%;
            source: root.poster;
            image-fit: cover;
        }

        if (!root.has_poster): Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(145deg, #1E1B4B 0%, #0F172A 50%, #1E293B 100%);

            VerticalLayout {
                alignment: center;
                padding: 18px;
                spacing: 12px;

                // Stylized Game Controller Icon
                Rectangle {
                    width: 54px;
                    height: 54px;
                    border-radius: 27px;
                    background: #FFFFFF15;
                    border-width: 1px;
                    border-color: #FFFFFF25;

                    Text {
                        text: "🎮";
                        font-size: 24px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-title;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        // Layer 2: Favorite Star Badge (Top-Right)
        if (root.is_favorite): Rectangle {
            x: parent.width - 36px;
            y: 10px;
            width: 26px;
            height: 26px;
            border-radius: 13px;
            background: #000000B0;
            border-width: 1px;
            border-color: Theme.accent-gold;

            Text {
                text: "★";
                color: Theme.accent-gold;
                font-size: 14px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Layer 3: Bottom Gradient Vignette & Metadata Overlay
        Rectangle {
            y: parent.height - 96px;
            height: 96px;
            width: 100%;
            background: @linear-gradient(0deg, #070A11F8 0%, #070A11D0 55%, #00000000 100%);

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 12px;
                alignment: end;
                spacing: 6px;

                // Title
                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    font-weight: 800;
                    overflow: elide;
                }

                // Launcher Pill & Focus Status
                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    // Launcher Tag
                    Rectangle {
                        height: 20px;
                        border-radius: 5px;
                        background: root.launcher == "Steam" ? Theme.steam-color :
                                   (root.launcher == "Epic" ? Theme.epic-color :
                                   (root.launcher == "Xbox" ? Theme.xbox-color : Theme.standalone-color));

                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 7px;
                            Text {
                                text: root.launcher;
                                color: #FFFFFF;
                                font-size: Theme.font-badge;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if (root.is_card_focused): Text {
                        text: "READY";
                        color: Theme.accent;
                        font-size: Theme.font-badge;
                        font-weight: 800;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Mouse & Touch click support
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.clicked();
            }
        }
    }
}
