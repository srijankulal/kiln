import { Theme } from "theme.slint";
import { GameCard } from "game_card.slint";
import { GamepadBadge } from "gamepad_badge.slint";

export struct GameItem {
    id: string,
    title: string,
    launcher: string,
    has_poster: bool,
    poster: image,
    last_played: string,
    playtime_hours: string,
    is_favorite: bool,
}

export component MainWindow inherits Window {
    title: "Kiln";
    default-font-family: "Segoe UI, sans-serif";
    background: #080B12;
    min-width: 1280px;
    min-height: 720px;

    // View State
    in-out property <[GameItem]> games: [];
    in-out property <[GameItem]> recent_games: [];
    in-out property <int> selected_tab: 0; // 0: All, 1: Recent, 2: Favorites, 3: Steam, 4: Epic, 5: Other, 6: Settings
    in-out property <int> focused_card_index: 0;
    
    // Modal State
    in-out property <bool> show_game_detail: false;
    in-out property <GameItem> selected_game;
    in-out property <bool> show_power_menu: false;
    
    // Game Mode Optimizer & Warning State
    in-out property <bool> show_game_mode_prompt: false;
    in-out property <bool> is_optimizing: false;
    in-out property <string> opt_status_text: "Ready to dedicate system hardware exclusively to gaming.";
    in-out property <float> opt_progress: 0.0;
    in-out property <string> opt_report_text: "";
    in-out property <bool> opt_completed: false;
    
    // System Status
    in-out property <string> clock_time: "12:00";
    in-out property <int> trim_tier: 1; // 0: Safe, 1: Default/Suspend, 2: Aggressive
    in-out property <bool> close_launcher_on_exit: false;
    in-out property <string> display_info: "TV: 3840x2160 @ 120Hz";
    in-out property <string> status_message: "";

    // Derived Carousel scroll offset for the primary shelf
    property <length> carousel_scroll_offset: root.focused_card_index > 2 ? ((root.focused_card_index - 2) * 232px) : 0px;

    // Callbacks to Rust backend
    callback play_game(string);
    callback toggle_favorite(string);
    callback change_tab(int);
    callback set_trim_tier(int);
    callback toggle_close_launcher();
    callback rescan_library();
    callback power_action(string); // "exit", "sleep", "restart", "shutdown"
    callback trigger_game_mode_optimization();
    callback dismiss_game_mode_prompt();
    callback nav_up();
    callback nav_down();
    callback nav_left();
    callback nav_right();
    callback nav_select();
    callback nav_back();
    callback nav_favorite();
    callback nav_next_tab();
    callback nav_prev_tab();

    // Top Level Key Handling & Auto-Focus
    forward-focus: main-scope;
    init => { main-scope.focus(); }

    main-scope := FocusScope {
        key-pressed(event) => {
            // Modal intercept for Game Mode Optimization Prompt
            if (root.show_game_mode_prompt) {
                if (event.text == Key.Return || event.text == " ") {
                    if (root.opt_completed) {
                        root.dismiss_game_mode_prompt();
                    } else if (!root.is_optimizing) {
                        root.trigger_game_mode_optimization();
                    }
                    return accept;
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    if (!root.is_optimizing) {
                        root.dismiss_game_mode_prompt();
                    }
                    return accept;
                }
                return accept;
            }

            // Standard Keyboard & Controller navigation
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.nav_back();
                return accept;
            }
            if (event.text == Key.Tab || event.text == "e" || event.text == "E" || event.text == "]") {
                root.nav_next_tab();
                return accept;
            }
            if (event.text == "q" || event.text == "Q" || event.text == "[") {
                root.nav_prev_tab();
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == "a" || event.text == "A") {
                root.nav_left();
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == "d" || event.text == "D") {
                root.nav_right();
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == "w" || event.text == "W") {
                root.nav_up();
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == "s" || event.text == "S") {
                root.nav_down();
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                root.nav_select();
                return accept;
            }
            if (event.text == "f" || event.text == "F" || event.text == "x" || event.text == "X") {
                root.nav_favorite();
                return accept;
            }
            if (event.text == "r" || event.text == "R" || event.text == "y" || event.text == "Y") {
                root.rescan_library();
                return accept;
            }
            if (event.text == "o" || event.text == "O") {
                root.show_game_mode_prompt = true;
                return accept;
            }
            return reject;
        }

        // Fullscreen atmospheric backdrop
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #0C121D 0%, #07090E 50%, #04060A 100%);

            // Subtle top glow flare
            Rectangle {
                width: 70%;
                height: 200px;
                y: -100px;
                x: (parent.width - self.width) / 2;
                background: @radial-gradient(circle, #00D2FF14 0%, #00000000 70%);
            }

            // Main Content Layout within TV safe margins
            VerticalLayout {
                padding-left: 44px;
                padding-right: 44px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: 16px;
                alignment: space-between;

                // 1. TOP HEADER BAR
                HorizontalLayout {
                    height: 48px;
                    alignment: space-between;

                    // Left: Logo + Tab Switcher
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;

                        // Brand Emblem
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: @linear-gradient(135deg, #FF5533 0%, #B91C1C 100%);
                                border-width: 1px;
                                border-color: #FFAA88;
                                y: 8px;

                                Text {
                                    text: "▲";
                                    color: #FFFFFF;
                                    font-size: 15px;
                                    font-weight: 900;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "KILN";
                                color: #FFFFFF;
                                font-size: 20px;
                                font-weight: 900;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                            }
                        }

                        // Divider
                        Rectangle {
                            width: 1px;
                            height: 22px;
                            background: #FFFFFF15;
                            y: 13px;
                        }

                        // Category Tab Bar
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;

                            // Tab 0: All
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: root.selected_tab == 0 ? #00D2FF22 : #00000000;
                                border-width: root.selected_tab == 0 ? 1px : 0px;
                                border-color: #00D2FF80;
                                y: 8px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: "ALL";
                                        color: root.selected_tab == 0 ? #00D2FF : #8A98AC;
                                        font-size: 13px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected_tab = 0; root.change_tab(0); }
                                }
                            }

                            // Tab 1: Recent
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: root.selected_tab == 1 ? #00D2FF22 : #00000000;
                                border-width: root.selected_tab == 1 ? 1px : 0px;
                                border-color: #00D2FF80;
                                y: 8px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: "RECENT";
                                        color: root.selected_tab == 1 ? #00D2FF : #8A98AC;
                                        font-size: 13px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected_tab = 1; root.change_tab(1); }
                                }
                            }

                            // Tab 2: Favorites
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: root.selected_tab == 2 ? #00D2FF22 : #00000000;
                                border-width: root.selected_tab == 2 ? 1px : 0px;
                                border-color: #00D2FF80;
                                y: 8px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: "FAVORITES";
                                        color: root.selected_tab == 2 ? #00D2FF : #8A98AC;
                                        font-size: 13px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected_tab = 2; root.change_tab(2); }
                                }
                            }

                            // Tab 3: Steam
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: root.selected_tab == 3 ? #00D2FF22 : #00000000;
                                border-width: root.selected_tab == 3 ? 1px : 0px;
                                border-color: #00D2FF80;
                                y: 8px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: "STEAM";
                                        color: root.selected_tab == 3 ? #00D2FF : #8A98AC;
                                        font-size: 13px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected_tab = 3; root.change_tab(3); }
                                }
                            }

                            // Tab 4: Epic
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: root.selected_tab == 4 ? #00D2FF22 : #00000000;
                                border-width: root.selected_tab == 4 ? 1px : 0px;
                                border-color: #00D2FF80;
                                y: 8px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: "EPIC";
                                        color: root.selected_tab == 4 ? #00D2FF : #8A98AC;
                                        font-size: 13px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected_tab = 4; root.change_tab(4); }
                                }
                            }

                            // Tab 5: Settings
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: root.selected_tab == 6 ? #00D2FF22 : #00000000;
                                border-width: root.selected_tab == 6 ? 1px : 0px;
                                border-color: #00D2FF80;
                                y: 8px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: "SETTINGS";
                                        color: root.selected_tab == 6 ? #00D2FF : #8A98AC;
                                        font-size: 13px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected_tab = 6; root.change_tab(6); }
                                }
                            }
                        }
                    }

                    // Right: Clock, Optimizer Trigger, & Power
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: end;

                        // Quick Game Mode Trigger
                        Rectangle {
                            height: 32px;
                            border-radius: 16px;
                            background: #00D2FF18;
                            border-width: 1px;
                            border-color: #00D2FF60;
                            y: 8px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;

                                Text {
                                    text: "⚡";
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "GAME MODE";
                                    color: #00D2FF;
                                    font-size: 12px;
                                    font-weight: 800;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show_game_mode_prompt = true; }
                            }
                        }

                        // Digital Clock
                        Text {
                            text: root.clock_time;
                            color: #FFFFFF;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        // Power Button
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: #1E293B80;
                            border-width: 1px;
                            border-color: #FF553380;
                            y: 6px;

                            Text {
                                text: "⏻";
                                color: #FF5533;
                                font-size: 17px;
                                font-weight: 900;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show_power_menu = true; }
                            }
                        }
                    }
                }

                // 2. MAIN VIEW AREA (GAMES LIBRARY OR SETTINGS)
                if (root.selected_tab != 6): VerticalLayout {
                    spacing: 18px;

                    // Hero Showcase Banner (Dynamic spotlight on active game)
                    if (root.selected_game.title != ""): Rectangle {
                        height: 110px;
                        border-radius: 16px;
                        background: @linear-gradient(90deg, #131C2DB8 0%, #0A111EB0 50%, #00000000 100%);
                        border-width: 1px;
                        border-color: #24355280;

                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            alignment: space-between;

                            // Left: Title + Badges
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;

                                Text {
                                    text: root.selected_game.title;
                                    color: #FFFFFF;
                                    font-size: 26px;
                                    font-weight: 900;
                                    letter-spacing: 0.5px;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    // Launcher Tag
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 6px;
                                        background: root.selected_game.launcher == "Steam" ? #1A78C2 :
                                                   (root.selected_game.launcher == "Epic" ? #334155 :
                                                   (root.selected_game.launcher == "Xbox" ? #107C10 : #7C3AED));

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: root.selected_game.launcher;
                                                color: #FFFFFF;
                                                font-size: 11px;
                                                font-weight: 800;
                                                letter-spacing: 0.5px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if (root.selected_game.playtime_hours != ""): Text {
                                        text: "⏱ " + root.selected_game.playtime_hours + " PLAYED";
                                        color: #94A3B8;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    if (root.selected_game.last_played != ""): Text {
                                        text: "•  LAST PLAYED: " + root.selected_game.last_played;
                                        color: #64748B;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    if (root.selected_game.is_favorite): Text {
                                        text: "★ FAVORITE";
                                        color: #FBBF24;
                                        font-size: 12px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Right: Prominent Play Button Trigger
                            HorizontalLayout {
                                spacing: 14px;
                                alignment: center;

                                Rectangle {
                                    height: 44px;
                                    border-radius: 12px;
                                    background: @linear-gradient(135deg, #00D2FF 0%, #0088CC 100%);
                                    border-width: 1px;
                                    border-color: #88EEFF;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        spacing: 8px;
                                        alignment: center;

                                        Text {
                                            text: "▶";
                                            color: #050A14;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "PLAY (Enter)";
                                            color: #050A14;
                                            font-size: 14px;
                                            font-weight: 900;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.play_game(root.selected_game.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Shelf Header
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.selected_tab == 0 ? "ALL GAMES" :
                                  (root.selected_tab == 1 ? "RECENTLY PLAYED" :
                                  (root.selected_tab == 2 ? "FAVORITES" :
                                  (root.selected_tab == 3 ? "STEAM LIBRARY" :
                                  (root.selected_tab == 4 ? "EPIC GAMES" : "OTHER TITLES"))));
                            color: #FFFFFF;
                            font-size: 14px;
                            font-weight: 800;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: root.games.length + " TITLES";
                            color: #00D2FF;
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }

                    // Primary Game Carousel Shelf (Single, fluid ribbon)
                    if (root.games.length > 0): Rectangle {
                        height: 330px;
                        clip: true;

                        HorizontalLayout {
                            x: -root.carousel_scroll_offset;
                            animate x { duration: 160ms; easing: ease-out; }
                            spacing: 20px;
                            alignment: start;

                            for game[index] in root.games: GameCard {
                                title: game.title;
                                launcher: game.launcher;
                                has_poster: game.has_poster;
                                poster: game.poster;
                                is_favorite: game.is_favorite;
                                is_card_focused: root.focused_card_index == index;

                                clicked => {
                                    root.selected_game = game;
                                    root.focused_card_index = index;
                                    root.show_game_detail = true;
                                }
                            }
                        }
                    }

                    // Empty Library State
                    if (root.games.length == 0): Rectangle {
                        height: 330px;
                        border-radius: 16px;
                        background: #0D142460;
                        border-width: 1px;
                        border-color: #24355240;

                        VerticalLayout {
                            alignment: center;
                            spacing: 14px;

                            Text {
                                text: "🎮";
                                font-size: 40px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "No games found in this category";
                                color: #FFFFFF;
                                font-size: 18px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }

                            Rectangle {
                                width: 180px;
                                height: 40px;
                                border-radius: 8px;
                                background: #00D2FF;
                                x: (parent.width - self.width) / 2;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "↻ Rescan Library";
                                        color: #050A14;
                                        font-size: 13px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.rescan_library(); }
                                }
                            }
                        }
                    }
                }

                // 3. SETTINGS TAB (Clean 3-Card Dashboard)
                if (root.selected_tab == 6): VerticalLayout {
                    spacing: 16px;

                    Text {
                        text: "SYSTEM & CONSOLE SETTINGS";
                        color: #FFFFFF;
                        font-size: 20px;
                        font-weight: 900;
                        letter-spacing: 1px;
                    }

                    HorizontalLayout {
                        spacing: 20px;
                        alignment: space-between;

                        // Card 1: Performance & Process Optimizer
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 420px;
                            border-radius: 14px;
                            background: #0E1628B0;
                            border-width: 1px;
                            border-color: #24355280;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "⚡"; font-size: 20px; vertical-alignment: center; }
                                    Text {
                                        text: "Game Mode Optimizer";
                                        color: #00D2FF;
                                        font-size: 17px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Closes background consumer apps and flushes system RAM to dedicate maximum GPU/CPU power to games.";
                                    color: #94A3B8;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                Rectangle {
                                    height: 44px;
                                    border-radius: 8px;
                                    background: @linear-gradient(135deg, #00D2FF 0%, #0088CC 100%);

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        Text {
                                            text: "⚡ Run Game Mode Optimizer";
                                            color: #050A14;
                                            font-size: 13px;
                                            font-weight: 900;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.show_game_mode_prompt = true; }
                                    }
                                }

                                Text {
                                    text: "Trimming Tier Selection:";
                                    color: #CBD5E1;
                                    font-size: 12px;
                                    font-weight: 700;
                                }

                                Rectangle {
                                    height: 44px;
                                    border-radius: 8px;
                                    background: root.trim_tier == 0 ? #00D2FF25 : #131E33;
                                    border-width: root.trim_tier == 0 ? 2px : 1px;
                                    border-color: root.trim_tier == 0 ? #00D2FF : #243552;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;
                                        Text { text: "Tier 0: EcoQoS (Power Throttling)"; color: #FFFFFF; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                        if (root.trim_tier == 0): Text { text: "ACTIVE"; color: #00D2FF; font-size: 11px; font-weight: 900; vertical-alignment: center; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.set_trim_tier(0); } }
                                }

                                Rectangle {
                                    height: 44px;
                                    border-radius: 8px;
                                    background: root.trim_tier == 1 ? #00D2FF25 : #131E33;
                                    border-width: root.trim_tier == 1 ? 2px : 1px;
                                    border-color: root.trim_tier == 1 ? #00D2FF : #243552;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;
                                        Text { text: "Tier 1: Suspend (Default Console)"; color: #FFFFFF; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                        if (root.trim_tier == 1): Text { text: "ACTIVE"; color: #00D2FF; font-size: 11px; font-weight: 900; vertical-alignment: center; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.set_trim_tier(1); } }
                                }
                            }
                        }

                        // Card 2: Display & Television Setup
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 420px;
                            border-radius: 14px;
                            background: #0E1628B0;
                            border-width: 1px;
                            border-color: #24355280;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "📺"; font-size: 20px; vertical-alignment: center; }
                                    Text {
                                        text: "TV & Display Topology";
                                        color: #00D2FF;
                                        font-size: 17px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Configure 10-foot TV resolution, HDR output, and secondary screen isolation.";
                                    color: #94A3B8;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                Rectangle {
                                    height: 60px;
                                    border-radius: 8px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: #243552;

                                    VerticalLayout {
                                        padding: 10px;
                                        alignment: center;
                                        Text { text: "Primary Target"; color: #64748B; font-size: 11px; font-weight: 700; }
                                        Text { text: root.display_info; color: #FFFFFF; font-size: 13px; font-weight: 800; }
                                    }
                                }

                                Rectangle {
                                    height: 44px;
                                    border-radius: 8px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: #243552;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;
                                        Text { text: "Overscan Safe Margins (5%)"; color: #FFFFFF; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                        Text { text: "ENABLED"; color: #10B981; font-size: 11px; font-weight: 900; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Card 3: Shell Behavior
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 420px;
                            border-radius: 14px;
                            background: #0E1628B0;
                            border-width: 1px;
                            border-color: #24355280;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "🎮"; font-size: 20px; vertical-alignment: center; }
                                    Text {
                                        text: "Shell & Behavior";
                                        color: #00D2FF;
                                        font-size: 17px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Configure launcher exit rules, controller chord bindings, and automatic updates.";
                                    color: #94A3B8;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                Rectangle {
                                    height: 48px;
                                    border-radius: 8px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: #243552;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;
                                        Text { text: "Close Launcher on Game Exit"; color: #FFFFFF; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                        Text { text: root.close_launcher_on_exit ? "YES" : "NO"; color: root.close_launcher_on_exit ? #00D2FF : #64748B; font-size: 11px; font-weight: 900; vertical-alignment: center; }
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.toggle_close_launcher(); } }
                                }

                                Rectangle {
                                    height: 48px;
                                    border-radius: 8px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: #243552;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;
                                        Text { text: "Emergency Abort Chord (Back+Start)"; color: #FFFFFF; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                        Text { text: "5 SECONDS"; color: #FF5533; font-size: 11px; font-weight: 900; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }

                // 4. BOTTOM FOOTER BAR (Clean shortcuts & controls)
                HorizontalLayout {
                    height: 36px;
                    alignment: space-between;

                    // Left: Gamepad controls
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        GamepadBadge { btn: "A"; btn_color: #10B981; label: "Play"; }
                        GamepadBadge { btn: "B"; btn_color: #EF4444; label: "Back"; }
                        GamepadBadge { btn: "X"; btn_color: #3B82F6; label: "Favorite"; }
                        GamepadBadge { btn: "Y"; btn_color: #F59E0B; label: "Rescan"; }
                        GamepadBadge { btn: "LB/RB"; btn_color: #64748B; is_pill: true; label: "Tabs"; }
                    }

                    // Right: Keyboard shortcuts
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: #FFFFFF0D;
                            border-width: 1px;
                            border-color: #FFFFFF15;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: "⌨ [WASD/Arrows] Move   [Enter] Play   [Esc] Back   [Tab] Category   [O] Game Mode";
                                    color: #94A3B8;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL DIALOGS
    // ==========================================

    // 1. GAME DETAIL MODAL
    if (root.show_game_detail): Rectangle {
        width: 100%;
        height: 100%;
        background: #03060FCC;

        TouchArea { clicked => { root.show_game_detail = false; } }

        Rectangle {
            width: 780px;
            height: 480px;
            border-radius: 20px;
            background: @linear-gradient(180deg, #121828 0%, #0A0F1A 100%);
            border-width: 1px;
            border-color: #00D2FF60;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000D0;
            clip: true;

            HorizontalLayout {
                padding: 30px;
                spacing: 28px;

                // Poster
                Rectangle {
                    width: 250px;
                    height: 100%;
                    border-radius: 12px;
                    background: #151D30;
                    border-width: 1px;
                    border-color: #FFFFFF20;
                    clip: true;

                    if (root.selected_game.has_poster): Image {
                        width: 100%;
                        height: 100%;
                        source: root.selected_game.poster;
                        image-fit: cover;
                    }

                    if (!root.selected_game.has_poster): VerticalLayout {
                        alignment: center;
                        spacing: 12px;
                        Text { text: "🎮"; font-size: 40px; horizontal-alignment: center; }
                        Text { text: root.selected_game.title; color: #FFFFFF; font-size: 16px; font-weight: 800; horizontal-alignment: center; wrap: word-wrap; }
                    }
                }

                // Details & Actions
                VerticalLayout {
                    spacing: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: root.selected_game.title;
                            color: #FFFFFF;
                            font-size: 28px;
                            font-weight: 900;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                height: 24px;
                                border-radius: 6px;
                                background: root.selected_game.launcher == "Steam" ? #1A78C2 : #334155;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text { text: root.selected_game.launcher; color: #FFFFFF; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                                }
                            }
                            if (root.selected_game.playtime_hours != ""): Text { text: "⏱ " + root.selected_game.playtime_hours; color: #94A3B8; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        }

                        if (root.selected_game.last_played != ""): Text {
                            text: "Last played: " + root.selected_game.last_played;
                            color: #64748B;
                            font-size: 12px;
                        }
                    }

                    // Action buttons
                    VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            height: 50px;
                            border-radius: 12px;
                            background: @linear-gradient(135deg, #00D2FF 0%, #0088CC 100%);

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;
                                Text { text: "▶"; color: #050A14; font-size: 16px; vertical-alignment: center; }
                                Text { text: "PLAY NOW (Enter)"; color: #050A14; font-size: 15px; font-weight: 900; vertical-alignment: center; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show_game_detail = false;
                                    root.play_game(root.selected_game.id);
                                }
                            }
                        }

                        Rectangle {
                            height: 44px;
                            border-radius: 10px;
                            background: #1E293B80;
                            border-width: 1px;
                            border-color: #334155;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text { text: root.selected_game.is_favorite ? "★ In Favorites" : "☆ Add to Favorites (F)"; color: #FFFFFF; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.toggle_favorite(root.selected_game.id);
                                    root.selected_game.is_favorite = !root.selected_game.is_favorite;
                                }
                            }
                        }

                        Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: #111827;

                            HorizontalLayout {
                                alignment: center;
                                Text { text: "Close (Esc)"; color: #94A3B8; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show_game_detail = false; }
                            }
                        }
                    }
                }
            }
        }
    }

    // 2. POWER MENU MODAL
    if (root.show_power_menu): Rectangle {
        width: 100%;
        height: 100%;
        background: #03060FCC;

        TouchArea { clicked => { root.show_power_menu = false; } }

        Rectangle {
            width: 420px;
            height: 340px;
            border-radius: 16px;
            background: #0E1628;
            border-width: 1px;
            border-color: #243552;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000;

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                alignment: space-between;

                Text { text: "POWER OPTIONS"; color: #FFFFFF; font-size: 18px; font-weight: 900; horizontal-alignment: center; }

                Rectangle {
                    height: 48px;
                    border-radius: 10px;
                    background: #162032;
                    HorizontalLayout { padding-left: 18px; spacing: 10px; Text { text: "⏾"; color: #00D2FF; font-size: 16px; vertical-alignment: center; } Text { text: "Sleep System"; color: #FFFFFF; font-size: 13px; font-weight: 700; vertical-alignment: center; } }
                    TouchArea { mouse-cursor: pointer; clicked => { root.show_power_menu = false; root.power_action("sleep"); } }
                }

                Rectangle {
                    height: 48px;
                    border-radius: 10px;
                    background: #162032;
                    HorizontalLayout { padding-left: 18px; spacing: 10px; Text { text: "✕"; color: #CBD5E1; font-size: 16px; vertical-alignment: center; } Text { text: "Exit to Desktop (Esc)"; color: #FFFFFF; font-size: 13px; font-weight: 700; vertical-alignment: center; } }
                    TouchArea { mouse-cursor: pointer; clicked => { root.show_power_menu = false; root.power_action("exit"); } }
                }

                Rectangle {
                    height: 48px;
                    border-radius: 10px;
                    background: #162032;
                    HorizontalLayout { padding-left: 18px; spacing: 10px; Text { text: "↻"; color: #F59E0B; font-size: 16px; vertical-alignment: center; } Text { text: "Restart PC"; color: #FFFFFF; font-size: 13px; font-weight: 700; vertical-alignment: center; } }
                    TouchArea { mouse-cursor: pointer; clicked => { root.show_power_menu = false; root.power_action("restart"); } }
                }

                Rectangle {
                    height: 48px;
                    border-radius: 10px;
                    background: #2D1418;
                    border-width: 1px;
                    border-color: #EF444460;
                    HorizontalLayout { padding-left: 18px; spacing: 10px; Text { text: "⏻"; color: #EF4444; font-size: 16px; vertical-alignment: center; } Text { text: "Shut Down PC"; color: #EF4444; font-size: 13px; font-weight: 800; vertical-alignment: center; } }
                    TouchArea { mouse-cursor: pointer; clicked => { root.show_power_menu = false; root.power_action("shutdown"); } }
                }
            }
        }
    }

    // 3. GAME MODE GATEWAY & PERFORMANCE MODAL
    if (root.show_game_mode_prompt): Rectangle {
        width: 100%;
        height: 100%;
        background: #03060FE4;

        TouchArea {}

        Rectangle {
            width: 740px;
            height: 490px;
            border-radius: 18px;
            background: @linear-gradient(180deg, #121828 0%, #0A0E18 100%);
            border-width: 2px;
            border-color: root.opt_completed ? #10B981 : #00D2FF80;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000;
            clip: true;

            VerticalLayout {
                padding: 28px;
                spacing: 16px;
                alignment: space-between;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "⚡"; color: #00D2FF; font-size: 18px; vertical-alignment: center; }
                            Text { text: "KILN CONSOLE GAME MODE"; color: #00D2FF; font-size: 18px; font-weight: 900; letter-spacing: 1px; vertical-alignment: center; }
                        }
                        Text { text: "Dedicating maximum GPU, CPU, and RAM exclusively to gaming"; color: #94A3B8; font-size: 12px; }
                    }
                    if (!root.is_optimizing): Rectangle {
                        width: 32px; height: 32px; border-radius: 16px; background: #FFFFFF10;
                        Text { text: "✕"; color: #FFFFFF80; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.dismiss_game_mode_prompt(); } }
                    }
                }

                // Info Cards
                if (!root.is_optimizing && !root.opt_completed): VerticalLayout {
                    spacing: 12px;

                    Rectangle {
                        height: 100px;
                        border-radius: 10px;
                        background: #1C1214;
                        border-width: 1px;
                        border-color: #FF453A40;

                        HorizontalLayout {
                            padding: 14px;
                            spacing: 14px;
                            Text { text: "⚠️"; font-size: 24px; vertical-alignment: center; }
                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;
                                Text { text: "PLEASE SAVE YOUR WORK IN OTHER APPS"; color: #FF6961; font-size: 13px; font-weight: 800; }
                                Text { text: "Game Mode terminates unnecessary background apps (browsers, chat, code editors, media players) to reclaim physical RAM and minimize system latency."; color: #CBD5E1; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                    }

                    Rectangle {
                        height: 100px;
                        border-radius: 10px;
                        background: #0D1C16;
                        border-width: 1px;
                        border-color: #10B98140;

                        HorizontalLayout {
                            padding: 14px;
                            spacing: 14px;
                            Text { text: "🛡️"; font-size: 24px; vertical-alignment: center; }
                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;
                                Text { text: "SAFETY PACKET (0% Corruption Guarantee)"; color: #34D399; font-size: 13px; font-weight: 800; }
                                Text { text: "Windows Kernel, File Systems, Storage Drivers, Audio, Display, Defender, and Anti-Cheat Engines are strictly protected and will NEVER be touched."; color: #CBD5E1; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                    }
                }

                // Progress View
                if (root.is_optimizing): VerticalLayout {
                    spacing: 20px;
                    alignment: center;

                    Text { text: "OPTIMIZING SYSTEM HARDWARE"; color: #FFFFFF; font-size: 18px; font-weight: 900; horizontal-alignment: center; }
                    Text { text: root.opt_status_text; color: #00D2FF; font-size: 13px; horizontal-alignment: center; }

                    Rectangle {
                        height: 10px;
                        border-radius: 5px;
                        background: #1E293B;
                        clip: true;
                        Rectangle { x: 0px; width: root.opt_progress * parent.width; height: 100%; background: @linear-gradient(90deg, #00D2FF 0%, #3B82F6 100%); }
                    }
                }

                // Completed View
                if (root.opt_completed): VerticalLayout {
                    spacing: 14px;
                    alignment: center;

                    Text { text: "✓ CONSOLE GAME MODE ACTIVE"; color: #10B981; font-size: 18px; font-weight: 900; horizontal-alignment: center; }
                    Text { text: root.opt_report_text != "" ? root.opt_report_text : "1,420 MB RAM Reclaimed • Tasks Optimized"; color: #FFFFFF; font-size: 16px; font-weight: 800; horizontal-alignment: center; }
                    Text { text: "System latency minimized. Physical memory dedicated to games."; color: #94A3B8; font-size: 12px; horizontal-alignment: center; }
                }

                // Footer Buttons
                HorizontalLayout {
                    spacing: 14px;
                    alignment: end;

                    if (!root.is_optimizing && !root.opt_completed): HorizontalLayout {
                        spacing: 14px;

                        Rectangle {
                            width: 220px;
                            height: 46px;
                            border-radius: 10px;
                            background: #1E293B80;
                            border-width: 1px;
                            border-color: #334155;
                            HorizontalLayout { alignment: center; Text { text: "Continue Windowed (Esc)"; color: #CBD5E1; font-size: 12px; font-weight: 700; vertical-alignment: center; } }
                            TouchArea { mouse-cursor: pointer; clicked => { root.dismiss_game_mode_prompt(); } }
                        }

                        Rectangle {
                            width: 240px;
                            height: 46px;
                            border-radius: 10px;
                            background: @linear-gradient(135deg, #00D2FF 0%, #0088CC 100%);
                            HorizontalLayout { alignment: center; Text { text: "⚡ Activate Game Mode (Enter)"; color: #050A14; font-size: 12px; font-weight: 900; vertical-alignment: center; } }
                            TouchArea { mouse-cursor: pointer; clicked => { root.trigger_game_mode_optimization(); } }
                        }
                    }

                    if (root.opt_completed): Rectangle {
                        width: 240px;
                        height: 46px;
                        border-radius: 10px;
                        background: @linear-gradient(135deg, #10B981 0%, #059669 100%);
                        HorizontalLayout { alignment: center; Text { text: "Enter Dashboard (Enter)"; color: #FFFFFF; font-size: 13px; font-weight: 900; vertical-alignment: center; } }
                        TouchArea { mouse-cursor: pointer; clicked => { root.dismiss_game_mode_prompt(); } }
                    }
                }
            }
        }
    }
}
