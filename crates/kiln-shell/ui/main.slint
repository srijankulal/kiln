import { Theme } from "theme.slint";
import { GameCard } from "game_card.slint";
import { GamepadBadge } from "gamepad_badge.slint";

export struct GameItem {
    id: string,
    title: string,
    launcher: string,
    has_poster: bool,
    poster: image,
    last_played: string,
    playtime_hours: string,
    is_favorite: bool,
}

export component MainWindow inherits Window {
    title: "Kiln";
    default-font-family: "Segoe UI, sans-serif";
    background: Theme.background;
    min-width: 1280px;
    min-height: 720px;

    // View State
    in-out property <[GameItem]> games: [];
    in-out property <[GameItem]> recent_games: [];
    in-out property <int> selected_tab: 0; // 0: All, 1: Recent, 2: Favorites, 3: Steam, 4: Epic, 5: Standalone, 6: Settings
    in-out property <int> focused_card_index: 0;
    
    // Modal State
    in-out property <bool> show_game_detail: false;
    in-out property <GameItem> selected_game;
    in-out property <bool> show_power_menu: false;
    
    // Game Mode Optimizer & Warning State
    in-out property <bool> show_game_mode_prompt: true;
    in-out property <bool> is_optimizing: false;
    in-out property <string> opt_status_text: "Ready to dedicate system hardware exclusively to gaming.";
    in-out property <float> opt_progress: 0.0;
    in-out property <string> opt_report_text: "";
    in-out property <bool> opt_completed: false;
    
    // System Status
    in-out property <string> clock_time: "12:00";
    in-out property <int> trim_tier: 1; // 0: Safe, 1: Default/Suspend, 2: Aggressive
    in-out property <bool> close_launcher_on_exit: false;
    in-out property <string> display_info: "TV: 3840x2160 @ 120Hz";
    in-out property <string> status_message: "";

    // Derived Carousel offsets
    property <int> recent_active_idx: root.focused_card_index < 100 ? root.focused_card_index : 0;
    property <length> recent_scroll_offset: root.recent_active_idx > 2 ? ((root.recent_active_idx - 2) * 232px) : 0px;

    property <int> all_active_idx: root.focused_card_index >= 100 ? (root.focused_card_index - 100) : 0;
    property <length> all_scroll_offset: root.all_active_idx > 2 ? ((root.all_active_idx - 2) * 232px) : 0px;

    // Callbacks to Rust backend
    callback play_game(string);
    callback toggle_favorite(string);
    callback change_tab(int);
    callback set_trim_tier(int);
    callback toggle_close_launcher();
    callback rescan_library();
    callback power_action(string); // "exit", "sleep", "restart", "shutdown"
    callback trigger_game_mode_optimization();
    callback dismiss_game_mode_prompt();
    callback nav_up();
    callback nav_down();
    callback nav_left();
    callback nav_right();
    callback nav_select();
    callback nav_back();
    callback nav_favorite();
    callback nav_next_tab();
    callback nav_prev_tab();

    // Top Level Key Handling & Auto-Focus
    forward-focus: main-scope;
    init => { main-scope.focus(); }

    main-scope := FocusScope {
        key-pressed(event) => {
            // Modal intercept for Game Mode Optimization Prompt
            if (root.show_game_mode_prompt) {
                if (event.text == Key.Return || event.text == " ") {
                    if (root.opt_completed) {
                        root.dismiss_game_mode_prompt();
                    } else if (!root.is_optimizing) {
                        root.trigger_game_mode_optimization();
                    }
                    return accept;
                }
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    if (!root.is_optimizing) {
                        root.dismiss_game_mode_prompt();
                    }
                    return accept;
                }
                return accept;
            }

            // Standard Keyboard & Controller navigation
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.nav_back();
                return accept;
            }
            if (event.text == Key.Tab || event.text == "e" || event.text == "E" || event.text == "]") {
                root.nav_next_tab();
                return accept;
            }
            if (event.text == "q" || event.text == "Q" || event.text == "[") {
                root.nav_prev_tab();
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == "a" || event.text == "A") {
                root.nav_left();
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == "d" || event.text == "D") {
                root.nav_right();
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == "w" || event.text == "W") {
                root.nav_up();
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == "s" || event.text == "S") {
                root.nav_down();
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                root.nav_select();
                return accept;
            }
            if (event.text == "f" || event.text == "F" || event.text == "x" || event.text == "X") {
                root.nav_favorite();
                return accept;
            }
            if (event.text == "r" || event.text == "R" || event.text == "y" || event.text == "Y") {
                root.rescan_library();
                return accept;
            }
            if (event.text == "o" || event.text == "O") {
                root.show_game_mode_prompt = true;
                return accept;
            }
            return reject;
        }

        // Fullscreen atmospheric backdrop
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #0B111F 0%, #07090E 40%, #05060A 100%);

            // Subtle top glow flare
            Rectangle {
                width: 70%;
                height: 180px;
                y: -90px;
                x: (parent.width - self.width) / 2;
                background: @radial-gradient(circle, #00D2FF18 0%, #00000000 70%);
            }

            // Main Content Layout within safe margins (TV overscan)
            VerticalLayout {
                padding-left: Theme.safe-margin-h;
                padding-right: Theme.safe-margin-h;
                padding-top: Theme.safe-margin-v;
                padding-bottom: Theme.safe-margin-v;
                spacing: 18px;

                // 1. TOP HEADER BAR
                HorizontalLayout {
                    height: 52px;
                    alignment: space-between;

                    // Left: Logo and Status
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        // Kiln Brand Emblem
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;

                            // Glowing Ember Mark
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                background: @linear-gradient(135deg, Theme.accent-warm 0%, #B91C1C 100%);
                                border-width: 1px;
                                border-color: #FFAA88;
                                y: 9px;

                                Text {
                                    text: "▲";
                                    color: #FFFFFF;
                                    font-size: 16px;
                                    font-weight: 900;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 0px;

                                Text {
                                    text: "KILN";
                                    color: #FFFFFF;
                                    font-size: Theme.font-title;
                                    font-weight: 900;
                                    letter-spacing: 2px;
                                }

                                Text {
                                    text: "GAME MODE";
                                    color: Theme.accent;
                                    font-size: Theme.font-badge;
                                    font-weight: 800;
                                    letter-spacing: 1.5px;
                                }
                            }
                        }

                        // Divider
                        Rectangle {
                            width: 1px;
                            height: 24px;
                            background: Theme.border-subtle;
                            y: 14px;
                        }

                        // Status message / toast (if any)
                        if (root.status_message != ""): Rectangle {
                            height: 32px;
                            border-radius: 16px;
                            background: #10B98125;
                            border-width: 1px;
                            border-color: #10B98180;
                            y: 10px;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: root.status_message;
                                    color: #10B981;
                                    font-size: Theme.font-small;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Center: Controller Bumper Tabs (LB / RB)
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        // LB Bumper Badge
                        GamepadBadge {
                            btn: "LB";
                            btn_color: Theme.btn-bumper;
                            is_pill: true;
                        }

                        // Tab Pills
                        Rectangle {
                            height: 42px;
                            border-radius: 21px;
                            background: #0D1424B0;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: center;

                                // Tab 0: All
                                Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: root.selected_tab == 0 ? Theme.accent : #00000000;
                                    y: 5px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: "ALL";
                                            color: root.selected_tab == 0 ? #000000 : Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.selected_tab = 0; root.change_tab(0); }
                                    }
                                }

                                // Tab 1: Recent
                                Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: root.selected_tab == 1 ? Theme.accent : #00000000;
                                    y: 5px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: "RECENT";
                                            color: root.selected_tab == 1 ? #000000 : Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.selected_tab = 1; root.change_tab(1); }
                                    }
                                }

                                // Tab 2: Favorites
                                Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: root.selected_tab == 2 ? Theme.accent : #00000000;
                                    y: 5px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: "FAVORITES";
                                            color: root.selected_tab == 2 ? #000000 : Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.selected_tab = 2; root.change_tab(2); }
                                    }
                                }

                                // Tab 3: Steam
                                Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: root.selected_tab == 3 ? Theme.accent : #00000000;
                                    y: 5px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: "STEAM";
                                            color: root.selected_tab == 3 ? #000000 : Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.selected_tab = 3; root.change_tab(3); }
                                    }
                                }

                                // Tab 4: Epic
                                Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: root.selected_tab == 4 ? Theme.accent : #00000000;
                                    y: 5px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: "EPIC";
                                            color: root.selected_tab == 4 ? #000000 : Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.selected_tab = 4; root.change_tab(4); }
                                    }
                                }

                                // Tab 5: Other
                                Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: root.selected_tab == 5 ? Theme.accent : #00000000;
                                    y: 5px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: "OTHER";
                                            color: root.selected_tab == 5 ? #000000 : Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.selected_tab = 5; root.change_tab(5); }
                                    }
                                }

                                // Tab 6: Settings
                                Rectangle {
                                    height: 32px;
                                    border-radius: 16px;
                                    background: root.selected_tab == 6 ? Theme.accent : #00000000;
                                    y: 5px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        Text {
                                            text: "SETTINGS";
                                            color: root.selected_tab == 6 ? #000000 : Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.selected_tab = 6; root.change_tab(6); }
                                    }
                                }
                            }
                        }

                        // RB Bumper Badge
                        GamepadBadge {
                            btn: "RB";
                            btn_color: Theme.btn-bumper;
                            is_pill: true;
                        }
                    }

                    // Right: TV Display Pill, Clock & Power Button
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: end;

                        // TV Display Pill
                        Rectangle {
                            height: 34px;
                            border-radius: 17px;
                            background: #0E1628A0;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            y: 9px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                Text {
                                    text: "📺";
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.display_info;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-badge;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Clock
                        Text {
                            text: root.clock_time;
                            color: #FFFFFF;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        // Game Mode Optimizer Button
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: @linear-gradient(135deg, #00D2FF20 0%, #00779930 100%);
                            border-width: 1px;
                            border-color: Theme.accent;
                            y: 7px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 14px;
                                spacing: 6px;

                                Text {
                                    text: "⚡";
                                    color: Theme.accent;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "GAME MODE";
                                    color: Theme.text;
                                    font-size: Theme.font-badge;
                                    font-weight: 800;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show_game_mode_prompt = true; }
                            }
                        }

                        // Power Button
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            background: @linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
                            border-width: 1px;
                            border-color: Theme.accent-warm;
                            y: 7px;

                            Text {
                                text: "⏻";
                                color: Theme.accent-warm;
                                font-size: 18px;
                                font-weight: 900;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show_power_menu = true; }
                            }
                        }
                    }
                }

                // 2. MAIN VIEW AREA (GAMES LIBRARY OR SETTINGS)
                if (root.selected_tab != 6): VerticalLayout {
                    spacing: 16px;

                    // Hero Spotlight Banner (Live showcase of the focused game)
                    if (root.selected_game.title != ""): Rectangle {
                        height: 94px;
                        border-radius: 16px;
                        background: @linear-gradient(90deg, #121A2CB8 0%, #0C122070 50%, #00000000 100%);
                        border-width: 1px;
                        border-color: #243552;

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 22px;
                            alignment: space-between;

                            // Left: Poster Thumbnail + Title & Quick Stats
                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;

                                if (root.selected_game.has_poster): Rectangle {
                                    width: 44px;
                                    height: 66px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #FFFFFF30;
                                    clip: true;
                                    y: 14px;
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.selected_game.poster;
                                        image-fit: cover;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    Text {
                                        text: root.selected_game.title;
                                        color: #FFFFFF;
                                        font-size: Theme.font-headline;
                                        font-weight: 900;
                                        letter-spacing: 0.5px;
                                        overflow: elide;
                                    }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;

                                    Rectangle {
                                        height: 22px;
                                        border-radius: 5px;
                                        background: root.selected_game.launcher == "Steam" ? Theme.steam-color :
                                                   (root.selected_game.launcher == "Epic" ? Theme.epic-color :
                                                   (root.selected_game.launcher == "Xbox" ? Theme.xbox-color : Theme.standalone-color));

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: root.selected_game.launcher;
                                                color: #FFFFFF;
                                                font-size: Theme.font-badge;
                                                font-weight: 800;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if (root.selected_game.playtime_hours != ""): Text {
                                        text: "⏱ " + root.selected_game.playtime_hours + " PLAYED";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-badge;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    if (root.selected_game.last_played != ""): Text {
                                        text: "•  LAST PLAYED: " + root.selected_game.last_played;
                                        color: Theme.text-muted;
                                        font-size: Theme.font-badge;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    if (root.selected_game.is_favorite): Text {
                                        text: "★ FAVORITE";
                                        color: Theme.accent-gold;
                                        font-size: Theme.font-badge;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                            // Right: Controller Action Hints
                            HorizontalLayout {
                                spacing: 20px;
                                alignment: center;

                                GamepadBadge {
                                    btn: "A";
                                    btn_color: Theme.btn-a;
                                    label: "Play";
                                }

                                GamepadBadge {
                                    btn: "X";
                                    btn_color: Theme.btn-x;
                                    label: root.selected_game.is_favorite ? "Unfavorite" : "Favorite";
                                }
                            }
                        }
                    }

                    // Section 1: Continue Playing Row (shown on All Tab if recent games exist)
                    if (root.selected_tab == 0 && root.recent_games.length > 0): VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "CONTINUE PLAYING";
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                font-weight: 800;
                                letter-spacing: 1.2px;
                            }
                            Text {
                                text: root.recent_games.length + " RECENT";
                                color: Theme.text-muted;
                                font-size: Theme.font-badge;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        // Horizontal Carousel Shelf
                        Rectangle {
                            height: 350px;
                            clip: true;

                            HorizontalLayout {
                                x: -root.recent_scroll_offset;
                                animate x { duration: 160ms; easing: ease-out; }
                                spacing: 20px;
                                alignment: start;

                                for game[index] in root.recent_games: GameCard {
                                    title: game.title;
                                    launcher: game.launcher;
                                    has_poster: game.has_poster;
                                    poster: game.poster;
                                    is_favorite: game.is_favorite;
                                    is_card_focused: root.focused_card_index == index;

                                    clicked => {
                                        root.selected_game = game;
                                        root.show_game_detail = true;
                                    }
                                }
                            }
                        }
                    }

                    // Section 2: Library Grid / Shelf Header
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.selected_tab == 0 ? "ALL GAMES" :
                                  (root.selected_tab == 1 ? "RECENTLY PLAYED" :
                                  (root.selected_tab == 2 ? "FAVORITES" :
                                  (root.selected_tab == 3 ? "STEAM LIBRARY" :
                                  (root.selected_tab == 4 ? "EPIC GAMES" : "OTHER / STANDALONE"))));
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            font-weight: 800;
                            letter-spacing: 1.2px;
                        }

                        Text {
                            text: root.games.length + " GAMES INSTALLED";
                            color: Theme.accent;
                            font-size: Theme.font-badge;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }

                    // Section 3: Library Cards Carousel
                    if (root.games.length > 0): Rectangle {
                        height: 350px;
                        clip: true;

                        HorizontalLayout {
                            x: -root.all_scroll_offset;
                            animate x { duration: 160ms; easing: ease-out; }
                            spacing: 20px;
                            alignment: start;

                            for game[index] in root.games: GameCard {
                                title: game.title;
                                launcher: game.launcher;
                                has_poster: game.has_poster;
                                poster: game.poster;
                                is_favorite: game.is_favorite;
                                is_card_focused: root.focused_card_index == (index + 100) || (root.selected_tab != 0 && root.focused_card_index == index);

                                clicked => {
                                    root.selected_game = game;
                                    root.show_game_detail = true;
                                }
                            }
                        }
                    }

                    // Section 4: Empty State
                    if (root.games.length == 0): Rectangle {
                        height: 320px;
                        border-radius: 16px;
                        background: @linear-gradient(135deg, #0F1626A0 0%, #090E1AA0 100%);
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            alignment: center;
                            spacing: 16px;

                            Text {
                                text: "🎮";
                                font-size: 48px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "No games found in this category.";
                                color: Theme.text-primary;
                                font-size: Theme.font-title;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Kiln scans Steam, Epic Games, Xbox, and custom directories.";
                                color: Theme.text-secondary;
                                font-size: Theme.font-body;
                                horizontal-alignment: center;
                            }

                            Rectangle {
                                width: 220px;
                                height: 46px;
                                border-radius: 10px;
                                background: Theme.accent;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "↻";
                                        font-size: 16px;
                                        color: #000000;
                                        font-weight: 900;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Rescan Library";
                                        color: #000000;
                                        font-size: Theme.font-small;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.rescan_library(); }
                                }
                            }
                        }
                    }
                }

                // 3. SETTINGS DASHBOARD (Tab 6)
                if (root.selected_tab == 6): VerticalLayout {
                    spacing: 16px;

                    Text {
                        text: "SYSTEM & CONSOLE SETTINGS";
                        color: Theme.text-primary;
                        font-size: Theme.font-headline;
                        font-weight: 900;
                        letter-spacing: 1px;
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        alignment: space-between;

                        // Card 1: Performance & Process Trimming
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: @linear-gradient(180deg, #121A2CB0 0%, #0A101CB0 100%);
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "⚡"; font-size: 20px; vertical-alignment: center; }
                                    Text {
                                        text: "Background Trimming";
                                        color: Theme.accent;
                                        font-size: Theme.font-title;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Suspends non-essential background processes (browsers, chat, sync) to maximize game framerates and minimize latency.";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }

                                // Tier 0
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: root.trim_tier == 0 ? #00D2FF25 : #131E33;
                                    border-width: root.trim_tier == 0 ? 2px : 1px;
                                    border-color: root.trim_tier == 0 ? Theme.accent : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Tier 0: Safe (EcoQoS Throttling)";
                                                color: root.trim_tier == 0 ? Theme.accent : Theme.text-primary;
                                                font-size: Theme.font-small;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: "Lowers process priority without pausing execution";
                                                color: Theme.text-muted;
                                                font-size: Theme.font-badge;
                                            }
                                        }

                                        Text {
                                            text: root.trim_tier == 0 ? "● ACTIVE" : "○";
                                            color: root.trim_tier == 0 ? Theme.accent : Theme.text-muted;
                                            font-size: Theme.font-badge;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set_trim_tier(0); }
                                    }
                                }

                                // Tier 1 (Default)
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: root.trim_tier == 1 ? #00D2FF25 : #131E33;
                                    border-width: root.trim_tier == 1 ? 2px : 1px;
                                    border-color: root.trim_tier == 1 ? Theme.accent : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Tier 1: Balanced (Suspend Apps) [Default]";
                                                color: root.trim_tier == 1 ? Theme.accent : Theme.text-primary;
                                                font-size: Theme.font-small;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: "Suspends known resource-heavy background apps";
                                                color: Theme.text-muted;
                                                font-size: Theme.font-badge;
                                            }
                                        }

                                        Text {
                                            text: root.trim_tier == 1 ? "● ACTIVE" : "○";
                                            color: root.trim_tier == 1 ? Theme.accent : Theme.text-muted;
                                            font-size: Theme.font-badge;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set_trim_tier(1); }
                                    }
                                }

                                // Tier 2
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: root.trim_tier == 2 ? #00D2FF25 : #131E33;
                                    border-width: root.trim_tier == 2 ? 2px : 1px;
                                    border-color: root.trim_tier == 2 ? Theme.accent : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Tier 2: Aggressive (+ User Services)";
                                                color: root.trim_tier == 2 ? Theme.accent : Theme.text-primary;
                                                font-size: Theme.font-small;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: "Suspends all non-system background workloads";
                                                color: Theme.text-muted;
                                                font-size: Theme.font-badge;
                                            }
                                        }

                                        Text {
                                            text: root.trim_tier == 2 ? "● ACTIVE" : "○";
                                            color: root.trim_tier == 2 ? Theme.accent : Theme.text-muted;
                                            font-size: Theme.font-badge;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set_trim_tier(2); }
                                    }
                                }
                            }
                        }

                        // Card 2: Display & Power
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: @linear-gradient(180deg, #121A2CB0 0%, #0A101CB0 100%);
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "📺"; font-size: 20px; vertical-alignment: center; }
                                    Text {
                                        text: "Display & TV Mode";
                                        color: Theme.accent;
                                        font-size: Theme.font-title;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Manages display topology, power profiles, and lid behavior during console play.";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }

                                // Status Box 1: Topology
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        Text {
                                            text: "Target Display Topology";
                                            color: Theme.text-primary;
                                            font-size: Theme.font-small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "TV-Only (SDC_EXTERNAL)";
                                            color: Theme.accent;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Status Box 2: Lid Action
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        Text {
                                            text: "Laptop Lid Close Action";
                                            color: Theme.text-primary;
                                            font-size: Theme.font-small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "Do Nothing (Play with lid closed)";
                                            color: #10B981;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Status Box 3: Overscan
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        Text {
                                            text: "TV Overscan Protection";
                                            color: Theme.text-primary;
                                            font-size: Theme.font-small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "5% Safe Margins (Active)";
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Card 3: Launchers & Maintenance
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: @linear-gradient(180deg, #121A2CB0 0%, #0A101CB0 100%);
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "🚀"; font-size: 20px; vertical-alignment: center; }
                                    Text {
                                        text: "Launchers & Library";
                                        color: Theme.accent;
                                        font-size: Theme.font-title;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Configure on-demand launcher behaviors and trigger instant library index updates.";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }

                                // Close launcher toggle
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        Text {
                                            text: "Close Launcher after Game Exits";
                                            color: Theme.text-primary;
                                            font-size: Theme.font-small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        // Switch Pill
                                        Rectangle {
                                            width: 48px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: root.close_launcher_on_exit ? Theme.accent : #334155;
                                            y: 13px;

                                            Rectangle {
                                                width: 22px;
                                                height: 22px;
                                                border-radius: 11px;
                                                background: #FFFFFF;
                                                x: root.close_launcher_on_exit ? 24px : 2px;
                                                y: 2px;
                                                animate x { duration: 120ms; easing: ease-out; }
                                            }
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle_close_launcher(); }
                                    }
                                }

                                // Rescan Button
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: @linear-gradient(90deg, Theme.accent 0%, #0099FF 100%);

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        Text {
                                            text: "↻";
                                            color: #000000;
                                            font-size: 16px;
                                            font-weight: 900;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Rescan All Installed Games";
                                            color: #000000;
                                            font-size: Theme.font-small;
                                            font-weight: 900;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.rescan_library(); }
                                    }
                                }

                                // Journal State
                                Rectangle {
                                    height: 52px;
                                    border-radius: 10px;
                                    background: #131E33;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: space-between;

                                        Text {
                                            text: "Crash Protection Journal";
                                            color: Theme.text-primary;
                                            font-size: Theme.font-small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "WAL Active (Auto-Restore)";
                                            color: #10B981;
                                            font-size: Theme.font-small;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 4. BOTTOM CONTROLLER NAVIGATION BAR
                Rectangle {
                    height: 48px;
                    border-radius: 12px;
                    background: #0E1628B0;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 28px;
                        alignment: center;

                        GamepadBadge {
                            btn: "A";
                            btn_color: Theme.btn-a;
                            label: "Select / Play";
                        }

                        GamepadBadge {
                            btn: "B";
                            btn_color: Theme.btn-b;
                            label: "Power Menu";
                        }

                        GamepadBadge {
                            btn: "X";
                            btn_color: Theme.btn-x;
                            label: "Favorite";
                        }

                        GamepadBadge {
                            btn: "Y";
                            btn_color: Theme.btn-y;
                            label: "Rescan";
                        }

                        GamepadBadge {
                            btn: "TAB";
                            btn_color: Theme.btn-bumper;
                            is_pill: true;
                            label: "Next Tab";
                        }

                        GamepadBadge {
                            btn: "BACK+START";
                            btn_color: #DC2626;
                            is_pill: true;
                            label: "Emergency Abort (5s)";
                        }

                        // Keyboard Navigation Cheat-sheet
                        Rectangle {
                            height: 30px;
                            border-radius: 15px;
                            background: #FFFFFF0D;
                            border-width: 1px;
                            border-color: #FFFFFF18;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;

                                Text {
                                    text: "⌨ [WASD/Arrows] Navigate  [Enter] Select  [Esc] Back  [Q/E/Tab] Tabs  [F] Fav  [O] Game Mode";
                                    color: #A0B2C6;
                                    font-size: Theme.font-badge;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // GAME DETAIL MODAL OVERLAY
    if (root.show_game_detail): Rectangle {
        width: 100%;
        height: 100%;
        background: #03060FCC;

        TouchArea {
            clicked => { root.show_game_detail = false; }
        }

        // Modal Window Card
        Rectangle {
            width: 820px;
            height: 490px;
            border-radius: Theme.radius-xl + 6px;
            drop-shadow-blur: Theme.e3-blur;
            drop-shadow-offset-y: Theme.e3-offset;
            drop-shadow-color: Theme.e3-color;
            background: @linear-gradient(135deg, #111A2E 0%, #0B1120 100%);
            border-width: 2px;
            border-color: Theme.accent;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            HorizontalLayout {
                padding: 32px;
                spacing: 32px;

                // Left Column: Poster Art
                Rectangle {
                    width: 240px;
                    height: 360px;
                    border-radius: 14px;
                    background: Theme.surface-card;
                    clip: true;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    if (root.selected_game.has_poster): Image {
                        width: 100%;
                        height: 100%;
                        source: root.selected_game.poster;
                        image-fit: cover;
                    }

                    if (!root.selected_game.has_poster): Rectangle {
                        width: 100%;
                        height: 100%;
                        background: @linear-gradient(145deg, #1E1B4B 0%, #0F172A 100%);

                        VerticalLayout {
                            alignment: center;
                            padding: 20px;
                            spacing: 12px;

                            Text {
                                text: "🎮";
                                font-size: 32px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.selected_game.title;
                                color: #FFFFFF;
                                font-size: Theme.font-title;
                                font-weight: 800;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Right Column: Title, Metadata, Action Buttons
                VerticalLayout {
                    spacing: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: root.selected_game.title;
                            color: #FFFFFF;
                            font-size: Theme.font-headline;
                            font-weight: 900;
                            wrap: word-wrap;
                        }

                        // Launcher Badge & Playtime Pill Row
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Rectangle {
                                height: 26px;
                                border-radius: 6px;
                                background: root.selected_game.launcher == "Steam" ? Theme.steam-color :
                                           (root.selected_game.launcher == "Epic" ? Theme.epic-color :
                                           (root.selected_game.launcher == "Xbox" ? Theme.xbox-color : Theme.standalone-color));

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: root.selected_game.launcher;
                                        color: #FFFFFF;
                                        font-size: Theme.font-small;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if (root.selected_game.playtime_hours != ""): Rectangle {
                                height: 26px;
                                border-radius: 6px;
                                background: #1E293B;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: "⏱ " + root.selected_game.playtime_hours;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-small;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        if (root.selected_game.last_played != ""): Text {
                            text: "Last played: " + root.selected_game.last_played;
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                        }
                    }

                    // Action Buttons
                    VerticalLayout {
                        spacing: 12px;

                        // Primary Play Button
                        Rectangle {
                            height: 56px;
                            border-radius: 12px;
                            background: @linear-gradient(90deg, Theme.accent 0%, #0099FF 100%);

                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px;

                                Text {
                                    text: "▶";
                                    color: #000000;
                                    font-size: 20px;
                                    font-weight: 900;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "PLAY NOW";
                                    color: #000000;
                                    font-size: Theme.font-body;
                                    font-weight: 900;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show_game_detail = false;
                                    root.play_game(root.selected_game.id);
                                }
                            }
                        }

                        // Toggle Favorite Button
                        Rectangle {
                            height: 46px;
                            border-radius: 10px;
                            background: #182238;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;

                                Text {
                                    text: root.selected_game.is_favorite ? "★" : "☆";
                                    color: Theme.accent-gold;
                                    font-size: 16px;
                                    font-weight: 900;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.selected_game.is_favorite ? "In Favorites (Click to Remove)" : "Add to Favorites";
                                    color: root.selected_game.is_favorite ? Theme.accent-gold : #FFFFFF;
                                    font-size: Theme.font-small;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.toggle_favorite(root.selected_game.id);
                                    root.selected_game.is_favorite = !root.selected_game.is_favorite;
                                }
                            }
                        }

                        // Close Button
                        Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: #00000000;

                            Text {
                                text: "Close (Back)";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show_game_detail = false; }
                            }
                        }
                    }
                }
            }
        }
    }

    // POWER MENU MODAL OVERLAY
    if (root.show_power_menu): Rectangle {
        width: 100%;
        height: 100%;
        background: #03060FCC;

        TouchArea {
            clicked => { root.show_power_menu = false; }
        }

        // Power Options Card
        Rectangle {
            width: 520px;
            height: 420px;
            border-radius: Theme.radius-xl + 6px;
            drop-shadow-blur: Theme.e3-blur;
            drop-shadow-offset-y: Theme.e3-offset;
            drop-shadow-color: Theme.e3-color;
            background: @linear-gradient(135deg, #111A2E 0%, #0B1120 100%);
            border-width: 2px;
            border-color: Theme.accent-warm;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 30px;
                spacing: 16px;

                Text {
                    text: "POWER & SESSION";
                    color: #FFFFFF;
                    font-size: Theme.font-title;
                    font-weight: 900;
                    letter-spacing: 1.5px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Choose what to do with your laptop and current session";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                }

                // Option 1: Exit Game Mode
                Rectangle {
                    height: 54px;
                    border-radius: 12px;
                    background: @linear-gradient(90deg, #00D2FF25 0%, #0099FF15 100%);
                    border-width: 1px;
                    border-color: Theme.accent;

                    HorizontalLayout {
                        padding-left: 20px;
                        spacing: 12px;

                        Text { text: "⏻"; color: Theme.accent; font-size: 18px; vertical-alignment: center; }
                        Text {
                            text: "Exit Game Mode (Restore Windows Desktop)";
                            color: #FFFFFF;
                            font-size: Theme.font-small;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_power_menu = false;
                            root.power_action("exit");
                        }
                    }
                }

                // Option 2: Sleep
                Rectangle {
                    height: 54px;
                    border-radius: 12px;
                    background: #131E33;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 20px;
                        spacing: 12px;

                        Text { text: "☾"; color: Theme.text-secondary; font-size: 18px; vertical-alignment: center; }
                        Text {
                            text: "Sleep Laptop";
                            color: #FFFFFF;
                            font-size: Theme.font-small;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_power_menu = false;
                            root.power_action("sleep");
                        }
                    }
                }

                // Option 3: Restart PC
                Rectangle {
                    height: 54px;
                    border-radius: 12px;
                    background: #131E33;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 20px;
                        spacing: 12px;

                        Text { text: "↻"; color: Theme.text-secondary; font-size: 18px; vertical-alignment: center; }
                        Text {
                            text: "Restart Laptop";
                            color: #FFFFFF;
                            font-size: Theme.font-small;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_power_menu = false;
                            root.power_action("restart");
                        }
                    }
                }

                // Option 4: Shut Down PC
                Rectangle {
                    height: 54px;
                    border-radius: 12px;
                    background: #131E33;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 20px;
                        spacing: 12px;

                        Text { text: "⏻"; color: Theme.accent-warm; font-size: 18px; vertical-alignment: center; }
                        Text {
                            text: "Shut Down Laptop";
                            color: Theme.accent-warm;
                            font-size: Theme.font-small;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_power_menu = false;
                            root.power_action("shutdown");
                        }
                    }
                }
            }
        }
    }

    // GAME MODE GATEWAY & PERFORMANCE WARNING MODAL OVERLAY
    if (root.show_game_mode_prompt): Rectangle {
        width: 100%;
        height: 100%;
        background: #03060FE8;

        // Prevent click-through
        TouchArea {}

        // Modal Window Card
        Rectangle {
            width: 780px;
            height: 530px;
            border-radius: Theme.radius-xl + 6px;
            background: @linear-gradient(180deg, #121828 0%, #0B0F1A 100%);
            border-width: 2px;
            border-color: root.opt_completed ? #30D158 : Theme.border-focus;
            drop-shadow-blur: Theme.e3-blur;
            drop-shadow-offset-y: Theme.e3-offset;
            drop-shadow-color: Theme.e3-color;
            clip: true;

            VerticalLayout {
                padding: 30px;
                spacing: 18px;
                alignment: space-between;

                // Header with Badge
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                background: #00D2FF25;
                                border-width: 1px;
                                border-color: Theme.accent;
                                y: 3px;
                                Text {
                                    text: "⚡";
                                    font-size: 18px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "KILN CONSOLE GAME MODE";
                                color: Theme.accent;
                                font-size: Theme.font-title;
                                font-weight: 900;
                                letter-spacing: 1.2px;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "Optimize hardware priorities and RAM headroom for maximum gaming performance";
                            color: Theme.text-subtle;
                            font-size: Theme.font-small;
                        }
                    }

                    if (!root.is_optimizing): Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: #FFFFFF10;
                        Text {
                            text: "✕";
                            color: #FFFFFF80;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.dismiss_game_mode_prompt(); }
                        }
                    }
                }

                // Middle Content
                if (!root.is_optimizing && !root.opt_completed): VerticalLayout {
                    spacing: 14px;

                    // Warning Box (Closing consumer apps)
                    Rectangle {
                        height: 114px;
                        border-radius: Theme.radius-lg;
                        background: #1C1214;
                        border-width: 1px;
                        border-color: #FF453A40;

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 16px;
                            alignment: start;

                            Text {
                                text: "⚠️";
                                font-size: 28px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: "PLEASE SAVE YOUR WORK IN OTHER APPS";
                                    color: #FF6961;
                                    font-size: Theme.font-body;
                                    font-weight: 800;
                                }
                                Text {
                                    text: "Entering Game Mode terminates unnecessary consumer applications (browsers, chat apps, code editors, cloud sync, and media players) to release system RAM and CPU priorities exclusively to your games.";
                                    color: #D1D5DB;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // Safety Packet Box
                    Rectangle {
                        height: 114px;
                        border-radius: Theme.radius-lg;
                        background: #0D1C16;
                        border-width: 1px;
                        border-color: #30D15840;

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 16px;
                            alignment: start;

                            Text {
                                text: "🛡️";
                                font-size: 28px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: "SAFETY PACKET GUARANTEE (0% Corruption Risk)";
                                    color: #34D399;
                                    font-size: Theme.font-body;
                                    font-weight: 800;
                                }
                                Text {
                                    text: "Windows Kernel, File Systems, Storage Drivers, Audio, Display Compositor, Defender, and Anti-Cheat Engines are strictly protected under the Kiln Safety Packet and will NEVER be touched.";
                                    color: #D1D5DB;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Optimizing Progress View
                if (root.is_optimizing): VerticalLayout {
                    spacing: 24px;
                    alignment: center;

                    Text {
                        text: "OPTIMIZING SYSTEM HARDWARE";
                        color: #FFFFFF;
                        font-size: Theme.font-title;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.opt_status_text;
                        color: Theme.accent;
                        font-size: Theme.font-body;
                        horizontal-alignment: center;
                    }

                    // Progress track
                    Rectangle {
                        height: 12px;
                        border-radius: 6px;
                        background: #1B2438;
                        border-width: 1px;
                        border-color: #2F3E5E;
                        clip: true;

                        Rectangle {
                            x: 0px;
                            width: root.opt_progress * parent.width;
                            height: 100%;
                            background: @linear-gradient(90deg, #00D2FF 0%, #3B82F6 100%);
                            border-radius: 6px;
                        }
                    }
                }

                // Optimization Completed View
                if (root.opt_completed): VerticalLayout {
                    spacing: 18px;
                    alignment: center;

                    Rectangle {
                        width: 60px;
                        height: 60px;
                        border-radius: 30px;
                        background: #10B98125;
                        border-width: 2px;
                        border-color: #10B981;
                        x: (parent.width - self.width) / 2;

                        Text {
                            text: "✓";
                            color: #10B981;
                            font-size: 28px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "CONSOLE GAME MODE ACTIVATED";
                        color: #FFFFFF;
                        font-size: Theme.font-title;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.opt_report_text != "" ? root.opt_report_text : "1,420 MB RAM Reclaimed • Background Consumer Tasks Cleaned";
                        color: #34D399;
                        font-size: Theme.font-headline;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "CPU execution priority dedicated to games. System ready.";
                        color: Theme.text-subtle;
                        font-size: Theme.font-small;
                        horizontal-alignment: center;
                    }
                }

                // Action Footer Buttons
                HorizontalLayout {
                    spacing: 16px;
                    alignment: end;

                    if (!root.is_optimizing && !root.opt_completed): HorizontalLayout {
                        spacing: 16px;

                        // Skip / Continue button
                        Rectangle {
                            width: 250px;
                            height: 52px;
                            border-radius: Theme.radius-lg;
                            background: #162032;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "Continue Windowed (Esc)";
                                    color: #D1D5DB;
                                    font-size: Theme.font-small;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.dismiss_game_mode_prompt(); }
                            }
                        }

                        // Activate button
                        Rectangle {
                            width: 280px;
                            height: 52px;
                            border-radius: Theme.radius-lg;
                            background: @linear-gradient(135deg, Theme.accent 0%, #0088CC 100%);
                            border-width: 1px;
                            border-color: #88EEFF;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "⚡ Activate Game Mode (Enter)";
                                    color: #050A14;
                                    font-size: Theme.font-small;
                                    font-weight: 900;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.trigger_game_mode_optimization(); }
                            }
                        }
                    }

                    if (root.opt_completed): Rectangle {
                        width: 280px;
                        height: 52px;
                        border-radius: Theme.radius-lg;
                        background: @linear-gradient(135deg, #10B981 0%, #059669 100%);
                        border-width: 1px;
                        border-color: #6EE7B7;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: "Enter Dashboard (Enter)";
                                color: #FFFFFF;
                                font-size: Theme.font-body;
                                font-weight: 900;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.dismiss_game_mode_prompt(); }
                        }
                    }
                }
            }
        }
    }
}
