// Kiln 10-foot shell. Layout and screens only: tokens live in theme.slint,
// widgets in components.slint, icon codepoints in icons.slint, startup flow in launch.slint.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/JetBrainsMono-Regular.ttf";
import "../assets/fonts/lucide.ttf";

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, KeyCap, Hint, Button, IconButton, NavTab, GameTile, SettingRow, SectionLabel, Dialog, MenuItem, Prompts } from "components.slint";
import { LaunchScreen, LaunchApp, LaunchDisplay } from "launch.slint";
import { BootScreen } from "boot.slint";
import { GameLaunchScreen } from "launching.slint";
import { Logo } from "logo.slint";
import { Sfx, Haptics } from "sfx.slint";

export { Theme, Prompts, Sfx, Haptics, LaunchApp, LaunchDisplay }

export struct GameItem {
    id: string,
    title: string,
    launcher: string,
    has_poster: bool,
    poster: image,
    has_hero: bool,
    hero: image,
    last_played: string,
    playtime_hours: string,
    is_favorite: bool,
}

export component MainWindow inherits Window {
    title: "Kiln";
    icon: @image-url("../assets/kiln-512.png");
    default-font-family: Theme.family-ui;
    default-font-size: Theme.font-body;
    background: Theme.bg;
    min-width: 640px;
    min-height: 360px;
    preferred-width: 1280px;
    preferred-height: 760px;

    // ------------------------------------------------------------ library state
    in-out property <[GameItem]> games: [];
    in-out property <[GameItem]> recent_games: [];
    in-out property <int> selected_tab: 0; // 0 All, 1 Recent, 2 Favorites, 3 Steam, 4 Epic, 5 Other, 6 Settings
    in-out property <int> focused_card_index: 0;
    in-out property <GameItem> selected_game;

    // ------------------------------------------------------------ overlays
    in-out property <bool> show_game_detail: false;
    in-out property <bool> show_power_menu: false;
    in-out property <int> power_focus: 0; // 0 exit, 1 sleep, 2 restart, 3 shutdown

    // ------------------------------------------------------------ startup screen
    // Shown first on every launch, before Kiln goes full screen.
    in-out property <bool> show_launch: true;
    in-out property <bool> launch_dismissable: false;
    in-out property <[LaunchApp]> launch_apps: [];
    in-out property <[LaunchDisplay]> launch_displays: [];
    in-out property <int> launch_display_choice: 0;
    in-out property <int> launch_closing_count: 0;
    in-out property <int> launch_inactive_external: 0;
    in-out property <bool> launch_remember: true;
    in-out property <int> launch_focus: 0;
    in-out property <bool> launch_busy: false;
    in-out property <string> launch_status: "";
    in-out property <float> launch_progress: 0.0;

    // ------------------------------------------------------------ loading screen
    // Shown after Start while apps close and Kiln moves to its screen.
    in-out property <bool> show_boot: false;
    in-out property <string> boot_status: "";
    in-out property <bool> boot_done: false;
    in-out property <bool> boot_leaving: false;
    in-out property <bool> boot_playing: false;

    // ------------------------------------------------------------ game launch screen
    // Shown from Play until the game is up (see launching.slint). Phase: 0 starting,
    // 1 launcher needs the user, 2 game is up (fading out), 3 didn't start.
    in-out property <bool> show_game_launch: false;
    in-out property <GameItem> game_launch;
    in-out property <int> game_launch_phase: 0;
    in-out property <string> game_launch_status: "";
    // Focused tile's on-screen rectangle (the launch poster starts there).
    in-out property <length> launch_from_x: 0px;
    in-out property <length> launch_from_y: 0px;

    // ------------------------------------------------------------ system + settings
    in-out property <string> clock_time: "12:00";
    in-out property <bool> close_launcher_on_exit: false;
    in-out property <int> kept_apps_count: 0;
    in-out property <string> status_message: "";
    in-out property <int> settings_focus: 0;
    out property <int> settings_count: 18;

    // ------------------------------------------------------------ version + updates
    in-out property <string> app_version: "";
    // 0 not checked, 1 checking, 2 up to date, 3 available, 4 downloading, 5 installing, 6 failed
    in-out property <int> update_state: 0;
    in-out property <string> update_version: "";
    in-out property <string> update_detail: "";
    in-out property <float> update_progress: 0.0;

    // ------------------------------------------------------------ game folders dialog
    in-out property <[string]> game_folders: [];
    in-out property <bool> show_folders: false;
    // 0..n-1 folders, n "Add folder", n+1 "Done"
    in-out property <int> folders_focus: 0;

    // ------------------------------------------------------------ callbacks to Rust
    callback play_game(string);
    callback toggle_favorite(string);
    callback change_tab(int);
    callback toggle_close_launcher();
    callback rescan_library();
    callback power_action(string); // "exit", "sleep", "restart", "shutdown"
    callback settings_changed();
    callback open_launch();
    callback clear_kept_apps();
    callback add_game_folder();
    callback remove_game_folder(int);
    callback update_action(); // check for updates, or install the one found
    callback launch_set_app_close(int, bool);
    callback launch_choose_display(int);
    callback launch_toggle_remember();
    callback launch_refresh();
    callback launch_start();
    callback launch_quit();
    callback nav_up();
    callback nav_down();
    callback nav_left();
    callback nav_right();
    callback nav_select();
    callback nav_back();
    callback nav_favorite();
    callback nav_next_tab();
    callback nav_prev_tab();

    property <[{label: string, id: int}]> tabs: [
        { label: "All games", id: 0 },
        { label: "Recent", id: 1 },
        { label: "Favorites", id: 2 },
        { label: "Steam", id: 3 },
        { label: "Epic", id: 4 },
        { label: "Other", id: 5 },
        { label: "Settings", id: 6 },
    ];
    property <[string]> shelf-titles: ["All games", "Recently played", "Favorites", "Steam", "Epic Games", "Other games"];
    property <[string]> power-actions: ["exit", "sleep", "restart", "shutdown"];

    // ------------------------------------------------------------ viewport scaling
    init => {
        root.update-viewport();
        main-scope.focus();
    }
    changed width => { root.update-viewport(); }
    changed height => { root.update-viewport(); }

    function update-viewport() {
        Theme.viewport-width = self.width;
        Theme.viewport-height = self.height;
        Theme.viewport-scale = min(self.width / 1920px, self.height / 1080px);
    }

    // ------------------------------------------------------------ settings logic
    // Rows (index): 0 interface size, 1 text size, 2 tile size, 3 edge margin,
    // 4 theme, 5 accent, 6 font, 7 animations, 8 interface sounds, 9 sound volume,
    // 10 controller, 11 button prompts, 12 vibration, 13 startup screen,
    // 14 always-kept apps, 15 close launcher, 16 game folders, 17 version / updates.
    pure function wrap(v: int, d: int, n: int) -> int {
        if v + d < 0 { return n - 1; }
        if v + d >= n { return 0; }
        return v + d;
    }

    // Every value a setting row can change, so a step that changes nothing can bump.
    pure function settings-snapshot() -> string {
        return Theme.ui-scale + "|" + Theme.text-scale + "|" + Theme.tile-size + "|" + Theme.safe-area
            + "|" + Theme.theme-preset + "|" + Theme.accent-preset + "|" + Theme.font-preset
            + "|" + (Theme.animations ? "1" : "0") + "|" + (Sfx.enabled ? "1" : "0") + "|" + Sfx.volume
            + "|" + (Prompts.controller-enabled ? "1" : "0") + "|" + Prompts.style + "|" + Haptics.level
            + "|" + (root.close_launcher_on_exit ? "1" : "0");
    }
    pure function is-toggle-row(index: int) -> bool {
        return index == 7 || index == 8 || index == 10 || index == 15;
    }
    pure function toggle-row-on(index: int) -> bool {
        return index == 7 ? Theme.animations : index == 8 ? Sfx.enabled
            : index == 10 ? Prompts.controller-enabled : root.close_launcher_on_exit;
    }
    property <string> before-adjust;

    // Called from Rust for keyboard/controller input and from the rows for mouse input.
    // Plays adjust / toggle sounds, or a bump when the value can't move further.
    public function adjust-setting(index: int, delta: int) {
        root.before-adjust = root.settings-snapshot();
        root.apply-setting(index, delta);
        if root.settings-snapshot() == root.before-adjust {
            Sfx.play("bump", 0);
            return;
        }
        if root.is-toggle-row(index) {
            Sfx.play(root.toggle-row-on(index) ? "toggle-on" : "toggle-off", 0);
        } else {
            Sfx.play("adjust", delta);
        }
        root.settings_changed();
    }

    function apply-setting(index: int, delta: int) {
        if index == 0 {
            Theme.ui-scale = max(0.8, min(1.4, round((Theme.ui-scale + delta * 0.1) * 10) / 10));
        } else if index == 1 {
            Theme.text-scale = max(0.9, min(1.3, round((Theme.text-scale + delta * 0.1) * 10) / 10));
        } else if index == 2 {
            Theme.tile-size = max(0, min(2, Theme.tile-size + delta));
        } else if index == 3 {
            Theme.safe-area = max(0, min(5, Theme.safe-area + delta));
        } else if index == 4 {
            Theme.theme-preset = root.wrap(Theme.theme-preset, delta, Theme.theme-names.length);
        } else if index == 5 {
            Theme.accent-preset = root.wrap(Theme.accent-preset, delta, Theme.accent-names.length);
        } else if index == 6 {
            Theme.font-preset = root.wrap(Theme.font-preset, delta, Theme.font-preset-count);
        } else if index == 7 {
            Theme.animations = delta > 0;
        } else if index == 8 {
            Sfx.enabled = delta > 0;
        } else if index == 9 {
            Sfx.volume = max(0.1, min(1.0, round((Sfx.volume + delta * 0.1) * 10) / 10));
        } else if index == 10 {
            Prompts.controller-enabled = delta > 0;
        } else if index == 11 {
            Prompts.style = max(0, min(2, Prompts.style + delta));
        } else if index == 12 {
            Haptics.level = max(0, min(2, Haptics.level + delta));
            Haptics.preview();
        } else if index == 15 {
            if (delta > 0) != root.close_launcher_on_exit {
                root.toggle_close_launcher();
            }
        }
    }

    public function activate-setting(index: int) {
        if index == 2 {
            root.adjust-setting(2, Theme.tile-size == 2 ? -2 : 1);
        } else if index == 4 || index == 5 || index == 6 {
            root.adjust-setting(index, 1);
        } else if index == 7 {
            root.adjust-setting(7, Theme.animations ? -1 : 1);
        } else if index == 8 {
            root.adjust-setting(8, Sfx.enabled ? -1 : 1);
        } else if index == 10 {
            root.adjust-setting(10, Prompts.controller-enabled ? -1 : 1);
        } else if index == 11 {
            root.adjust-setting(11, Prompts.style == 2 ? -2 : 1);
        } else if index == 12 {
            root.adjust-setting(12, Haptics.level == 2 ? -2 : 1);
        } else if index == 13 {
            root.open_launch();
        } else if index == 14 {
            if root.kept_apps_count > 0 {
                root.clear_kept_apps();
                Sfx.play("confirm", 0);
            } else {
                Sfx.play("bump", 0);
            }
        } else if index == 15 {
            root.adjust-setting(15, root.close_launcher_on_exit ? -1 : 1);
        } else if index == 16 {
            root.folders_focus = root.game_folders.length;
            root.show_folders = true;
        } else if index == 17 {
            root.update_action();
        } else {
            Sfx.play("bump", 0); // sliders change with left/right, not select
        }
    }

    pure function pct(v: float) -> string {
        return round(v * 100) + "%";
    }

    // Settings list geometry (fixed row heights so focus can be scrolled into view).
    property <length> row-h: 40px * Theme.k + 56px * Theme.kt;
    property <length> row-gap: Theme.space-xs;
    property <length> label-h: 32px * Theme.k + 24px * Theme.kt;
    pure function row-y(i: int) -> length {
        return i * (root.row-h + root.row-gap) + (i < 4 ? 1 : i < 8 ? 2 : i < 10 ? 3 : i < 13 ? 4 : i < 16 ? 5 : i < 17 ? 6 : 7) * root.label-h;
    }

    // ------------------------------------------------------------ sounds for state changes
    // Mouse and keyboard/controller change the same properties, so both sound the same.
    // Overlapping cues from one gesture are resolved by priority in src/sound.rs.
    changed focused_card_index => { Sfx.play("move", self.focused_card_index); }
    changed settings_focus => { Sfx.play("move", self.settings_focus); }
    changed power_focus => { Sfx.play("move", self.power_focus); }
    changed launch_focus => { Sfx.play("move", self.launch_focus); }
    changed selected_tab => { Sfx.play("tab", self.selected_tab); }
    changed show_game_detail => { Sfx.play(self.show_game_detail ? "open" : "close", 0); }
    changed show_power_menu => { Sfx.play(self.show_power_menu ? "open" : "close", 0); }
    changed show_folders => { Sfx.play(self.show_folders ? "open" : "close", 0); }
    changed folders_focus => { Sfx.play("move", self.folders_focus); }
    changed show_launch => {
        if !self.show_boot { Sfx.play(self.show_launch ? "open" : "close", 0); }
    }

    function rescan-with-sound() {
        Sfx.play("select", 0);
        if root.show_launch { root.launch_refresh(); } else { root.rescan_library(); }
    }

    // ------------------------------------------------------------ input
    forward-focus: main-scope;

    main-scope := FocusScope {
        key-pressed(event) => {
            Prompts.last-input-controller = false;
            if root.show_boot { return accept; } // nothing to do until loading finishes
            if (event.text == Key.Escape || event.text == Key.Backspace) { root.nav_back(); return accept; }
            if (event.text == Key.Tab || event.text == "e" || event.text == "E" || event.text == "]") { root.nav_next_tab(); return accept; }
            if (event.text == "q" || event.text == "Q" || event.text == "[") { root.nav_prev_tab(); return accept; }
            if (event.text == Key.LeftArrow || event.text == "a" || event.text == "A") { root.nav_left(); return accept; }
            if (event.text == Key.RightArrow || event.text == "d" || event.text == "D") { root.nav_right(); return accept; }
            if (event.text == Key.UpArrow || event.text == "w" || event.text == "W") { root.nav_up(); return accept; }
            if (event.text == Key.DownArrow || event.text == "s" || event.text == "S") { root.nav_down(); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.nav_select(); return accept; }
            if (event.text == "f" || event.text == "F" || event.text == "x" || event.text == "X") { root.nav_favorite(); return accept; }
            if (event.text == "r" || event.text == "R" || event.text == "y" || event.text == "Y") {
                root.rescan-with-sound();
                return accept;
            }
            return reject;
        }

        // ======================================================== backdrop
        Rectangle { background: Theme.bg; }

        // Focused game's artwork fills the upper screen behind the info block.
        if root.selected_tab != 6 && root.games.length > 0: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: max(parent.height * 0.62, parent.width / 3.1);
            clip: true;

            if root.selected_game.has_hero: Image {
                width: parent.width;
                height: parent.height;
                source: root.selected_game.hero;
                image-fit: cover;
                horizontal-alignment: right;
            }
            if !root.selected_game.has_hero && root.selected_game.has_poster: Image {
                x: parent.width * 0.45;
                width: parent.width * 0.55;
                height: parent.height;
                source: root.selected_game.poster;
                image-fit: cover;
                opacity: 0.35;
            }
            // Fade artwork into the slate background. Only two-stop gradients: multi-stop
            // gradients with alpha show banding seams on the software renderer.
            Rectangle { background: Theme.bg.transparentize(0.55); }
            Rectangle {
                x: 0px;
                width: parent.width * 0.75;
                background: @linear-gradient(90deg, Theme.bg 0%, Theme.bg.transparentize(1) 100%);
            }
            Rectangle {
                y: parent.height * 0.35;
                height: parent.height * 0.65;
                background: @linear-gradient(0deg, Theme.bg 0%, Theme.bg.transparentize(1) 100%);
            }
            Rectangle {
                y: 0px;
                height: parent.height * 0.3;
                background: @linear-gradient(180deg, Theme.bg.transparentize(0.3) 0%, Theme.bg.transparentize(1) 100%);
            }
        }

        // ======================================================== foreground
        VerticalLayout {
            padding-top: Theme.margin-y;
            padding-bottom: Theme.margin-y;
            spacing: Theme.space-lg;

            // ---------------------------------------------------- top bar
            HorizontalLayout {
                padding-left: Theme.margin-x;
                padding-right: Theme.margin-x;
                spacing: Theme.space-lg;
                height: 56px * Theme.k;

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    horizontal-stretch: 0; // brand never takes the tabs' space
                    VerticalLayout {
                        alignment: center;
                        Logo { size: 44px * Theme.k; }
                    }
                    if !Theme.compact-h: Text {
                        text: "KILN";
                        font-family: Theme.family-display;
                        font-size: Theme.font-body-lg;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: 4px * Theme.kt;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }

                Rectangle { width: Theme.space-sm; }

                // Tabs clip (rather than push the clock off-screen) if they still don't fit.
                Rectangle {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    clip: true;
                    HorizontalLayout {
                    x: 0px;
                    width: self.preferred-width;
                    spacing: Theme.space-xxs;
                    if !Theme.compact-h: VerticalLayout { alignment: center; KeyCap { key: "LB"; wide: true; } }
                    for tab in root.tabs: NavTab {
                        label: tab.label;
                        selected: root.selected_tab == tab.id;
                        clicked => {
                            root.selected_tab = tab.id;
                            root.focused_card_index = 0;
                            root.change_tab(tab.id);
                        }
                    }
                    if !Theme.compact-h: VerticalLayout { alignment: center; KeyCap { key: "RB"; wide: true; } }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-md;
                    horizontal-stretch: 0;
                    Text {
                        text: root.clock_time;
                        font-family: Theme.family-display;
                        font-size: Theme.font-body-lg;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.power;
                            label: "Power options";
                            clicked => {
                                root.power_focus = 0;
                                root.show_power_menu = true;
                            }
                        }
                    }
                }
            }

            // ---------------------------------------------------- library view
            if root.selected_tab != 6: VerticalLayout {
                spacing: Theme.compact-v ? Theme.space-md : Theme.space-xl;
                vertical-stretch: 1;

                Rectangle { vertical-stretch: 1; }

                // Spotlight: focused game title, stats and actions.
                if root.games.length > 0: HorizontalLayout {
                    padding-left: Theme.margin-x;
                    padding-right: Theme.margin-x;
                    VerticalLayout {
                        spacing: Theme.space-md;
                        max-width: Theme.viewport-width * 0.7;

                        if !Theme.compact-v: Text {
                            text: root.selected_game.launcher;
                            color: Theme.accent-fg;
                            font-size: Theme.font-small;
                            font-weight: Theme.weight-semibold;
                            letter-spacing: Theme.tracking-wide;
                        }
                        Text {
                            text: root.selected_game.title;
                            color: Theme.text;
                            font-family: Theme.family-display;
                            font-size: Theme.font-display;
                            font-weight: Theme.weight-semibold;
                            letter-spacing: Theme.tracking-tight;
                            overflow: elide;
                        }
                        if !Theme.compact-v: HorizontalLayout {
                            spacing: Theme.space-lg;
                            alignment: start;
                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                Icon { glyph: Icons.clock; size: Theme.icon-sm; color: Theme.text-muted; }
                                Text { text: root.selected_game.playtime_hours; color: Theme.text-muted; font-size: Theme.font-body; vertical-alignment: center; }
                            }
                            if root.selected_game.last_played != "": HorizontalLayout {
                                spacing: Theme.space-xs;
                                Icon { glyph: Icons.history; size: Theme.icon-sm; color: Theme.text-muted; }
                                Text { text: "Played " + root.selected_game.last_played; color: Theme.text-muted; font-size: Theme.font-body; vertical-alignment: center; }
                            }
                            if root.selected_game.is_favorite: HorizontalLayout {
                                spacing: Theme.space-xs;
                                Icon { glyph: Icons.star; size: Theme.icon-sm; color: Theme.accent-fg; }
                                Text { text: "Favorite"; color: Theme.text-muted; font-size: Theme.font-body; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-md;
                            alignment: start;
                            padding-top: Theme.space-xs;
                            Button {
                                text: "Play";
                                icon: Icons.play;
                                variant: "primary";
                                clicked => { root.play_game(root.selected_game.id); }
                            }
                            Button {
                                text: "Details";
                                icon: Icons.info;
                                variant: "secondary";
                                clicked => { root.show_game_detail = true; }
                            }
                            Button {
                                text: root.selected_game.is_favorite ? "Favorited" : "Favorite";
                                icon: Icons.star;
                                variant: "secondary";
                                clicked => {
                                    root.toggle_favorite(root.selected_game.id);
                                    root.selected_game.is_favorite = !root.selected_game.is_favorite;
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // Shelf header
                if !Theme.compact-v || root.games.length == 0: HorizontalLayout {
                    padding-left: Theme.margin-x;
                    padding-right: Theme.margin-x;
                    spacing: Theme.space-md;
                    alignment: start;
                    Text {
                        text: root.shelf-titles[root.selected_tab];
                        color: Theme.text;
                        font-family: Theme.family-display;
                        font-size: Theme.font-title;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: bottom;
                    }
                    Text {
                        text: root.games.length == 1 ? "1 title" : root.games.length + " titles";
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: bottom;
                    }
                }

                // Shelf: one row of tiles, bleeding to the screen edges.
                if root.games.length > 0: shelf := Rectangle {
                    property <length> pitch: Theme.tile-width + Theme.tile-gap;
                    property <length> pad: Theme.focus-ring * 4;
                    property <length> content-w: root.games.length * pitch - Theme.tile-gap;
                    property <length> visible-w: self.width - Theme.margin-x * 2;
                    property <length> offset: max(0px, min((root.focused_card_index - 1) * pitch, content-w - visible-w));
                    height: Theme.tile-height + Theme.tile-lift + pad * 2;
                    clip: true;

                    HorizontalLayout {
                        x: Theme.margin-x - shelf.offset;
                        y: Theme.tile-lift + shelf.pad;
                        width: shelf.content-w;
                        height: Theme.tile-height;
                        spacing: Theme.tile-gap;
                        animate x { duration: Theme.motion-normal; easing: ease-out; }

                        for game[index] in root.games: GameTile {
                            // The focused tile reports where it is on screen, so the launch
                            // screen's poster can grow out of it.
                            property <bool> is-focus: root.focused_card_index == index;
                            property <length> ax: self.absolute-position.x;
                            property <length> ay: self.absolute-position.y - Theme.tile-lift;
                            function report() {
                                if self.is-focus {
                                    root.launch_from_x = self.ax;
                                    root.launch_from_y = self.ay;
                                }
                            }
                            init => { self.report(); }
                            changed is-focus => { self.report(); }
                            changed ax => { self.report(); }
                            changed ay => { self.report(); }
                            title: game.title;
                            launcher: game.launcher;
                            has-poster: game.has_poster;
                            poster: game.poster;
                            favorite: game.is_favorite;
                            focused: root.focused_card_index == index;
                            clicked => {
                                root.focused_card_index = index;
                                root.selected_game = game;
                                root.show_game_detail = true;
                            }
                        }
                    }
                }

                // Empty state
                if root.games.length == 0: HorizontalLayout {
                    padding-left: Theme.margin-x;
                    padding-right: Theme.margin-x;
                    Rectangle {
                        height: Theme.tile-height;
                        border-radius: Theme.radius-xl;
                        background: Theme.surface-1;
                        border-width: Theme.hairline;
                        border-color: Theme.border;
                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.space-md;
                            Icon { glyph: root.selected_tab == 2 ? Icons.star : Icons.library; size: Theme.icon-lg; color: Theme.text-faint; }
                            Text {
                                text: "Nothing here yet";
                                color: Theme.text;
                                font-family: Theme.family-display;
                                font-size: Theme.font-title;
                                font-weight: Theme.weight-semibold;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.selected_tab == 2 ? "Press X on any game to pin it here."
                                    : root.selected_tab == 1 ? "Games you play will show up here."
                                    : "Kiln didn't find any games from this source.";
                                color: Theme.text-muted;
                                font-size: Theme.font-body;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center;
                                padding-top: Theme.space-xs;
                                Button {
                                    text: "Rescan library";
                                    icon: Icons.refresh;
                                    keycap: "Y";
                                    variant: "secondary";
                                    clicked => { root.rescan-with-sound(); }
                                }
                            }
                        }
                    }
                }
            }

            // ---------------------------------------------------- settings view
            if root.selected_tab == 6: HorizontalLayout {
                padding-left: Theme.margin-x;
                padding-right: Theme.margin-x;
                spacing: Theme.space-xxl;
                vertical-stretch: 1;

                VerticalLayout {
                    horizontal-stretch: 3;
                    spacing: Theme.space-lg;

                    VerticalLayout {
                        spacing: Theme.space-xxs;
                        padding-top: Theme.space-lg;
                        Text {
                            text: "Settings";
                            color: Theme.text;
                            font-family: Theme.family-display;
                            font-size: Theme.font-headline;
                            font-weight: Theme.weight-semibold;
                        }
                        if !Theme.compact-v: Text {
                            text: "Changes apply instantly and are saved on this device.";
                            color: Theme.text-muted;
                            font-size: Theme.font-body;
                        }
                    }

                    list := Flickable {
                        vertical-stretch: 1;
                        content-height: root.row-y(root.settings_count) + Theme.space-lg;

                        property <int> focus-index: root.settings_focus;
                        changed focus-index => { list.follow-focus(); }
                        changed height => { list.follow-focus(); }
                        // Start the view exactly at a row (or the very top), never mid-row: show as
                        // many whole rows above the focused one as fit in half the list.
                        function follow-focus() {
                            list.content-y = -max(0px, min(
                                root.settings_focus - floor((list.height - root.row-h) / 2 / (root.row-h + root.row-gap)) <= 0 ? 0px
                                    : root.row-y(root.settings_focus - floor((list.height - root.row-h) / 2 / (root.row-h + root.row-gap))) - root.label-h,
                                list.content-height - list.height));
                        }

                        VerticalLayout {
                            spacing: root.row-gap;
                            alignment: start;

                            SectionLabel { text: "DISPLAY"; height: root.label-h - root.row-gap; vertical-alignment: bottom; }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.scaling;
                                label: "Interface size";
                                description: "Scales the whole interface for your screen and seating distance.";
                                kind: 0;
                                value: root.pct(Theme.ui-scale);
                                progress: (Theme.ui-scale - 0.8) / 0.6;
                                focused: root.settings_focus == 0;
                                adjust(d) => { root.adjust-setting(0, d); }
                                pointer-entered => { root.settings_focus = 0; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.text-size;
                                label: "Text size";
                                description: "Makes text larger or smaller on top of the interface size.";
                                kind: 0;
                                value: root.pct(Theme.text-scale);
                                progress: (Theme.text-scale - 0.9) / 0.4;
                                focused: root.settings_focus == 1;
                                adjust(d) => { root.adjust-setting(1, d); }
                                pointer-entered => { root.settings_focus = 1; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.grid;
                                label: "Game tile size";
                                description: "How large posters appear on the library shelf.";
                                kind: 1;
                                options: ["Small", "Medium", "Large"];
                                selected-option: Theme.tile-size;
                                focused: root.settings_focus == 2;
                                choose(i) => { root.adjust-setting(2, i - Theme.tile-size); }
                                pointer-entered => { root.settings_focus = 2; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.maximize;
                                label: "Screen edge margin";
                                description: "Adds space at the edges if your TV crops the picture.";
                                kind: 0;
                                value: Theme.safe-area + "%";
                                progress: Theme.safe-area / 5;
                                focused: root.settings_focus == 3;
                                adjust(d) => { root.adjust-setting(3, d); }
                                pointer-entered => { root.settings_focus = 3; }
                            }

                            SectionLabel { text: "APPEARANCE"; height: root.label-h - root.row-gap; vertical-alignment: bottom; }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.palette;
                                label: "Theme";
                                description: "Colour scheme for backgrounds and panels.";
                                kind: 1;
                                options: Theme.theme-names;
                                selected-option: Theme.theme-preset;
                                focused: root.settings_focus == 4;
                                choose(i) => { root.adjust-setting(4, i - Theme.theme-preset); }
                                pointer-entered => { root.settings_focus = 4; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.flame;
                                label: "Accent colour";
                                description: Theme.accent-names[Theme.accent-preset] + " highlights for focus, buttons and switches.";
                                kind: 4;
                                swatches: Theme.accent-swatches;
                                selected-option: Theme.accent-preset;
                                focused: root.settings_focus == 5;
                                choose(i) => { root.adjust-setting(5, i - Theme.accent-preset); }
                                pointer-entered => { root.settings_focus = 5; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.type;
                                label: "Font";
                                description: "Typeface used across the interface.";
                                kind: 1;
                                options: Theme.font-preset-names;
                                selected-option: Theme.font-preset;
                                focused: root.settings_focus == 6;
                                choose(i) => { root.adjust-setting(6, i - Theme.font-preset); }
                                pointer-entered => { root.settings_focus = 6; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.sparkles;
                                label: "Animations";
                                description: "Motion when moving focus and opening menus.";
                                kind: 2;
                                on: Theme.animations;
                                focused: root.settings_focus == 7;
                                activate => { root.activate-setting(7); }
                                pointer-entered => { root.settings_focus = 7; }
                            }

                            SectionLabel { text: "SOUND"; height: root.label-h - root.row-gap; vertical-alignment: bottom; }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.volume;
                                label: "Interface sounds";
                                description: "Soft tones for moving, selecting and the startup chime.";
                                kind: 2;
                                on: Sfx.enabled;
                                focused: root.settings_focus == 8;
                                activate => { root.activate-setting(8); }
                                pointer-entered => { root.settings_focus = 8; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.volume-low;
                                label: "Sound volume";
                                description: Sfx.enabled ? "Relative to the Windows volume." : "Turn on interface sounds to hear changes.";
                                kind: 0;
                                value: root.pct(Sfx.volume);
                                progress: (Sfx.volume - 0.1) / 0.9;
                                focused: root.settings_focus == 9;
                                adjust(d) => { root.adjust-setting(9, d); }
                                pointer-entered => { root.settings_focus = 9; }
                            }

                            SectionLabel { text: "CONTROLS"; height: root.label-h - root.row-gap; vertical-alignment: bottom; }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.gamepad;
                                label: "Controller";
                                description: "Navigate Kiln with a gamepad. Back + Start (hold 5 s) always exits.";
                                kind: 2;
                                on: Prompts.controller-enabled;
                                focused: root.settings_focus == 10;
                                activate => { root.activate-setting(10); }
                                pointer-entered => { root.settings_focus = 10; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.keyboard;
                                label: "Button hints";
                                description: "Auto shows controller buttons after you use a gamepad.";
                                kind: 1;
                                options: ["Auto", "Keyboard", "Controller"];
                                selected-option: Prompts.style;
                                focused: root.settings_focus == 11;
                                choose(i) => { root.adjust-setting(11, i - Prompts.style); }
                                pointer-entered => { root.settings_focus = 11; }
                            }

                            SettingRow {
                                height: root.row-h;
                                icon: Icons.zap;
                                label: "Vibration";
                                description: "A light buzz for Play, errors and list ends. Never in games.";
                                kind: 1;
                                options: ["Off", "Light", "Strong"];
                                selected-option: Haptics.level;
                                focused: root.settings_focus == 12;
                                choose(i) => { root.adjust-setting(12, i - Haptics.level); }
                                pointer-entered => { root.settings_focus = 12; }
                            }

                            SectionLabel { text: "STARTUP & APPS"; height: root.label-h - root.row-gap; vertical-alignment: bottom; }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.monitor;
                                label: "Startup screen";
                                description: "Choose apps to close and which screen Kiln uses.";
                                kind: 3;
                                value: "Open";
                                focused: root.settings_focus == 13;
                                activate => { root.activate-setting(13); }
                                pointer-entered => { root.settings_focus = 13; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.lock;
                                label: "Always-kept apps";
                                description: root.kept_apps_count == 0 ? "None yet. Choose Keep on the startup screen to add apps."
                                    : root.kept_apps_count == 1 ? "1 app is never closed by Kiln."
                                    : root.kept_apps_count + " apps are never closed by Kiln.";
                                kind: 3;
                                value: root.kept_apps_count == 0 ? "" : "Clear list";
                                focused: root.settings_focus == 14;
                                activate => { root.activate-setting(14); }
                                pointer-entered => { root.settings_focus = 14; }
                            }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.log-out;
                                label: "Close launcher after playing";
                                description: "Quits Steam or Epic when you exit a game.";
                                kind: 2;
                                on: root.close_launcher_on_exit;
                                focused: root.settings_focus == 15;
                                activate => { root.activate-setting(15); }
                                pointer-entered => { root.settings_focus = 15; }
                            }

                            SectionLabel { text: "LIBRARY"; height: root.label-h - root.row-gap; vertical-alignment: bottom; }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.folder;
                                label: "Game folders";
                                description: root.game_folders.length == 0 ? "Add folders with games that aren't on Steam or Epic."
                                    : root.game_folders.length == 1 ? "1 folder. Each game in it shows up in your library."
                                    : root.game_folders.length + " folders. Each game in them shows up in your library.";
                                kind: 3;
                                value: "Manage";
                                focused: root.settings_focus == 16;
                                activate => { root.activate-setting(16); }
                                pointer-entered => { root.settings_focus = 16; }
                            }

                            SectionLabel { text: "ABOUT"; height: root.label-h - root.row-gap; vertical-alignment: bottom; }
                            SettingRow {
                                height: root.row-h;
                                icon: Icons.info;
                                label: "Kiln version " + root.app_version;
                                description: root.update_state == 1 ? "Checking for updates…"
                                    : root.update_state == 2 ? "You have the latest version."
                                    : root.update_state == 3 ? "Version " + root.update_version + " is available. Kiln restarts to finish."
                                    : root.update_state == 4 ? "Downloading version " + root.update_version + "…"
                                    : root.update_state == 5 ? "Installing. Kiln will restart by itself."
                                    : root.update_state == 6 ? "Couldn't update: " + root.update_detail
                                    : "Updates are checked automatically.";
                                kind: 3;
                                value: root.update_state == 3 ? "Install update"
                                    : root.update_state == 4 ? root.pct(root.update_progress)
                                    : root.update_state == 1 || root.update_state == 5 ? "…"
                                    : "Check for updates";
                                focused: root.settings_focus == 17;
                                activate => { root.activate-setting(17); }
                                pointer-entered => { root.settings_focus = 17; }
                            }
                        }
                    }
                }

                // Side panel: live display facts and controls reference (scrolls if it can't fit).
                Flickable {
                    horizontal-stretch: 2;
                    content-height: side.preferred-height;
                    side := VerticalLayout {
                    width: parent.width;
                    padding-top: Theme.space-lg;
                    spacing: Theme.space-lg;
                    alignment: start;

                    Rectangle {
                        border-radius: Theme.radius-lg;
                        background: Theme.surface-1;
                        border-width: Theme.hairline;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: Theme.space-lg;
                            spacing: Theme.space-md;
                            SectionLabel { text: "THIS SCREEN"; }
                            for fact in [
                                { k: "Kiln version", v: root.app_version },
                                { k: "Window", v: round(Theme.viewport-width / 1px) + " × " + round(Theme.viewport-height / 1px) },
                                { k: "Effective scale", v: root.pct(Theme.k) },
                                { k: "Font", v: Theme.font-preset-names[Theme.font-preset] },
                            ]: HorizontalLayout {
                                Text { text: fact.k; color: Theme.text-muted; font-size: Theme.font-body; horizontal-stretch: 1; }
                                Text { text: fact.v; color: Theme.text; font-family: Theme.family-mono; font-size: Theme.font-body; }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: Theme.radius-lg;
                        background: Theme.surface-1;
                        border-width: Theme.hairline;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: Theme.space-lg;
                            spacing: Theme.space-md;
                            SectionLabel { text: "CONTROLS"; }
                            Hint { key: "A"; label: "Select or change"; }
                            Hint { key: "B"; label: "Back / power menu"; }
                            Hint { key: "X"; label: "Favorite game"; }
                            Hint { key: "Y"; label: "Rescan library"; }
                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                VerticalLayout { alignment: center; horizontal-stretch: 0; KeyCap { key: "LB"; } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0; KeyCap { key: "RB"; } }
                                Text { text: "Switch tabs"; color: Theme.text-muted; font-size: Theme.font-small; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                Icon { glyph: Icons.gamepad; size: Theme.icon-sm; color: Theme.text-muted; }
                                Text {
                                    text: "In a game, hold both sticks in (L3 + R3) to return.";
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                Icon { glyph: Icons.alert; size: Theme.icon-sm; color: Theme.warning; }
                                Text {
                                    text: "Hold Back + Start for 5 seconds to exit to the desktop.";
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    }
                }
            }

            // ---------------------------------------------------- footer
            HorizontalLayout {
                padding-left: Theme.margin-x;
                padding-right: Theme.margin-x;
                spacing: Theme.space-lg;
                height: 40px * Theme.kt;

                if root.status_message != "": HorizontalLayout {
                    spacing: Theme.space-xs;
                    Icon { glyph: Icons.info; size: Theme.icon-sm; color: Theme.accent-fg; }
                    Text { text: root.status_message; color: Theme.text-muted; font-size: Theme.font-small; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.selected_tab != 6: Hint { key: "A"; label: "Open"; }
                if root.selected_tab == 6: Hint { key: "A"; label: "Change"; }
                Hint { key: "B"; label: "Menu"; }
                if root.selected_tab != 6: Hint { key: "X"; label: "Favorite"; }
                if root.selected_tab != 6: Hint { key: "Y"; label: "Rescan"; }
            }
        }
    }

    // ============================================================ game details
    if root.show_game_detail: Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { root.show_game_detail = false; } }

        Dialog {
            width: min(1180px * Theme.k, parent.width - Theme.margin-x * 2);
            height: min(640px * Theme.k, parent.height - Theme.margin-y * 2);
            TouchArea {}

            HorizontalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-xl;

                Rectangle {
                    width: self.height / 1.5;
                    border-radius: Theme.radius-lg;
                    background: Theme.surface-2;
                    clip: true;
                    if root.selected_game.has_poster: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.selected_game.poster;
                        image-fit: cover;
                    }
                    if !root.selected_game.has_poster: Icon { glyph: Icons.gamepad; size: Theme.icon-lg; color: Theme.text-faint; }
                }

                VerticalLayout {
                    spacing: Theme.space-md;
                    horizontal-stretch: 1;
                    Text {
                        text: root.selected_game.launcher;
                        color: Theme.accent-fg;
                        font-size: Theme.font-small;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: Theme.tracking-wide;
                    }
                    Text {
                        text: root.selected_game.title;
                        color: Theme.text;
                        font-family: Theme.family-display;
                        font-size: Theme.font-headline;
                        font-weight: Theme.weight-semibold;
                        wrap: word-wrap;
                    }
                    Rectangle { height: Theme.space-xs; }
                    for fact in [
                        { icon: Icons.clock, k: "Play time", v: root.selected_game.playtime_hours },
                        { icon: Icons.history, k: "Last played", v: root.selected_game.last_played != "" ? root.selected_game.last_played : "Never" },
                        { icon: Icons.library, k: "Library", v: root.selected_game.launcher },
                    ]: HorizontalLayout {
                        spacing: Theme.space-sm;
                        Icon { glyph: fact.icon; size: Theme.icon-sm; color: Theme.text-muted; width: 32px * Theme.kt; }
                        Text { text: fact.k; color: Theme.text-muted; font-size: Theme.font-body; width: 200px * Theme.kt; vertical-alignment: center; }
                        Text { text: fact.v; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: Theme.space-md;
                        alignment: start;
                        Button {
                            text: "Play";
                            icon: Icons.play;
                            keycap: "A";
                            variant: "primary";
                            clicked => {
                                root.show_game_detail = false;
                                root.play_game(root.selected_game.id);
                            }
                        }
                        Button {
                            text: root.selected_game.is_favorite ? "Favorited" : "Favorite";
                            icon: Icons.star;
                            keycap: "X";
                            variant: "secondary";
                            clicked => {
                                root.toggle_favorite(root.selected_game.id);
                                root.selected_game.is_favorite = !root.selected_game.is_favorite;
                            }
                        }
                        Button {
                            text: "Close";
                            keycap: "B";
                            variant: "ghost";
                            clicked => { root.show_game_detail = false; }
                        }
                    }
                }
            }
        }
    }

    // ============================================================ power menu
    if root.show_power_menu: Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { root.show_power_menu = false; } }

        Dialog {
            width: min(560px * Theme.k, parent.width - Theme.margin-x * 2);
            height: pm.preferred-height;
            TouchArea {}

            pm := VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-xs;
                VerticalLayout {
                    padding: Theme.space-xs;
                    padding-bottom: Theme.space-md;
                    spacing: Theme.space-xxs;
                    Text { text: "Power"; color: Theme.text; font-family: Theme.family-display; font-size: Theme.font-title; font-weight: Theme.weight-semibold; }
                    Text { text: "Kiln restores your desktop settings before exiting."; color: Theme.text-muted; font-size: Theme.font-small; wrap: word-wrap; }
                }
                for item[i] in [
                    { icon: Icons.log-out, label: "Exit to desktop", danger: false },
                    { icon: Icons.moon, label: "Sleep", danger: false },
                    { icon: Icons.rotate-ccw, label: "Restart", danger: false },
                    { icon: Icons.power, label: "Shut down", danger: true },
                ]: MenuItem {
                    icon: item.icon;
                    label: item.label;
                    danger: item.danger;
                    focused: root.power_focus == i;
                    pointer-entered => { root.power_focus = i; }
                    clicked => {
                        root.show_power_menu = false;
                        root.power_action(root.power-actions[i]);
                    }
                }
            }
        }
    }

    // ============================================================ game folders
    if root.show_folders: Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { root.show_folders = false; } }

        Dialog {
            width: min(860px * Theme.k, parent.width - Theme.margin-x * 2);
            height: min(fd.preferred-height, parent.height - Theme.margin-y * 2);
            TouchArea {}

            fd := VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-xs;
                VerticalLayout {
                    padding: Theme.space-xs;
                    padding-bottom: Theme.space-md;
                    spacing: Theme.space-xxs;
                    Text { text: "Game folders"; color: Theme.text; font-family: Theme.family-display; font-size: Theme.font-title; font-weight: Theme.weight-semibold; }
                    Text {
                        text: "Each folder, shortcut or game .exe directly inside these folders shows up as a game. Removing a folder only hides its games from Kiln; nothing is deleted.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }
                for folder[i] in root.game_folders: MenuItem {
                    icon: Icons.folder;
                    label: folder;
                    hint: "Remove";
                    focused: root.folders_focus == i;
                    pointer-entered => { root.folders_focus = i; }
                    clicked => { root.remove_game_folder(i); }
                }
                MenuItem {
                    icon: Icons.folder-plus;
                    label: "Add a folder…";
                    focused: root.folders_focus == root.game_folders.length;
                    pointer-entered => { root.folders_focus = root.game_folders.length; }
                    clicked => { root.add_game_folder(); }
                }
                MenuItem {
                    icon: Icons.check;
                    label: "Done";
                    focused: root.folders_focus == root.game_folders.length + 1;
                    pointer-entered => { root.folders_focus = root.game_folders.length + 1; }
                    clicked => { root.show_folders = false; }
                }
            }
        }
    }

    // ============================================================ game launch
    if root.show_game_launch: GameLaunchScreen {
        title: root.game_launch.title;
        launcher: root.game_launch.launcher;
        has-poster: root.game_launch.has_poster;
        poster: root.game_launch.poster;
        has-hero: root.game_launch.has_hero;
        hero: root.game_launch.hero;
        from-x: root.launch_from_x;
        from-y: root.launch_from_y;
        from-w: Theme.tile-width;
        from-h: Theme.tile-height;
        phase: root.game_launch_phase;
        status: root.game_launch_status;
        close => { root.show_game_launch = false; }
    }

    // ============================================================ startup screen
    if root.show_launch: LaunchScreen {
        apps: root.launch_apps;
        displays: root.launch_displays;
        display-choice: root.launch_display_choice;
        closing-count: root.launch_closing_count;
        inactive-external: root.launch_inactive_external;
        remember: root.launch_remember;
        focus-index: root.launch_focus;
        busy: root.launch_busy;
        status: root.launch_status;
        progress: root.launch_progress;
        dismissable: root.launch_dismissable;
        set-app-close(i, v) => { root.launch_set_app_close(i, v); }
        choose-display(i) => { root.launch_choose_display(i); }
        toggle-remember => { root.launch_toggle_remember(); }
        refresh => { root.rescan-with-sound(); }
        start-clicked => { root.launch_start(); }
        quit => { root.launch_quit(); }
        dismiss => { root.show_launch = false; }
        hover-focus(i) => { root.launch_focus = i; }
    }

    // ============================================================ loading screen
    if root.show_boot: BootScreen {
        status: root.boot_status;
        done: root.boot_done;
        leaving: root.boot_leaving;
        playing: root.boot_playing;
    }
}
